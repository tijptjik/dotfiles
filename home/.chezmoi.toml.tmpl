sourceDir = {{ joinPath .chezmoi.homeDir ".local/share/dotjik" | quote }}
encryption = "age"
[age]
    identity = "~/.keys/chezmoi.txt"
    recipient = "age10cpp7avz2zzlqea22d5c3l83ew36rxfjxl2gcxm79atjkcp7494s3lpvjx"

{{- $hostname := .chezmoi.hostname -}}
{{- $role := output "python3" (joinPath .chezmoi.sourceDir "../scripts/device-policy.py") "role" | trim -}}
{{- $isClient := or (eq $role "desktop") (eq $role "laptop") }}

[data]
    hostname = "{{ $hostname }}"
    isClient = {{ $isClient }}
    isDesktop = {{ eq $role "desktop" }}
    isLaptop = {{ eq $role "laptop" }}
    isServer = {{ eq $role "server" }}
    bitwardenUsername = "m@hype.hk"
    anthropicModelProvider = "zai" # "claude", "moonshot" or "zai"

[git]
    # tjikup pushes only commits that already exist locally.
    autoCommit = false
    autoPush = false

[diff]
    pager = "diff-so-fancy"

[diff.filter]
    ".json" = { command = "jq", args = ["."] }

[edit]
    command = "zed"
    args = ["--wait"]

[bitwardenSecrets]
    command = "{{ .chezmoi.sourceDir }}/.bws-wrapper.fish"

[hooks.read-source-state.pre]
    command = "{{ .chezmoi.sourceDir }}/.bitwarden-check.fish"
    identity = "~/.keys/chezmoi.txt"
