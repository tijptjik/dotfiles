#!/usr/bin/env fish
if test "$FLEET_DEFER_HOOKS" = 1
    exit 0
end
source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"

# Herdr updates are routine fleet coverage, including when FLEET_UPGRADE=0.
# Respect the upstream guard: do not disguise a pane as an outside terminal.
if test "$HERDR_ENV" = 1; or test "$TERM_PROGRAM" = herdr
    status_msg WARN "!" "Herdr" "update deferred: rerun tjikup outside Herdr"
    exit 0
end

if not command -q herdr
    status_msg FAILED "✗" "Herdr" "binary missing; rerun the Herdr install hook"
    exit 1
end

set -l before (command herdr --version)
or exit $status
status_msg UPDATE "..." "Herdr"
# No handoff and no interactive consent to stop active pane processes.
# Upstream can return success after declining a session-stopping update.
set -l output (command herdr update </dev/null 2>&1)
set -l code $status
if test $code -ne 0
    printf '%s\n' $output
    status_msg FAILED "✗" "Herdr" "update failed"
    exit $code
end

set -l after (command herdr --version)
or exit $status
if string match -q '*Herdr was not updated.*' -- $output
    status_msg WARN "!" "Herdr" "update deferred: stop sessions when ready, then rerun tjikup"
else if test "$before" = "$after"
    status_msg SKIP "✓" "Herdr" "no changes ($after)"
else
    status_msg UPDATE "✓" "Herdr" "$before → $after"
end
