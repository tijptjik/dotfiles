#!/usr/bin/env fish
if test "$FLEET_DEFER_HOOKS" = 1
    exit 0
end
{{ if .isClient -}}
source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"
# The official Sublime repository is provisioned by Chezetc.
if not rpm -q sublime-text >/dev/null 2>&1
    stage 'Sublime Text' INSTALL 'Sublime Text' sudo dnf install -y sublime-text
    or exit $status
else
    status_msg INSTALL '✓' 'Sublime Text' 'installed; updates follow DNF'
end
{{ end -}}
