#!/usr/bin/env fish
if test "$FLEET_DEFER_HOOKS" = 1
    exit 0
end
{{ if .isClient -}}
source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"
stage_dynamic_note 'Obsidian AppImage' INSTALL 'Obsidian' \
    python3 "{{ .chezmoi.sourceDir }}/../scripts/install-obsidian.py"
or exit $status
{{ end -}}
