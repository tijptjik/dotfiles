#!/usr/bin/env fish
{{ if .isClient -}}
# The systemd backup service may use system Python rather than ~/.venv.
if not /usr/bin/python3 -c 'import cryptography' >/dev/null 2>&1
    source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"
    stage "device archive dependencies" INSTALL "Telegram theme reader" sudo dnf install -y python3-cryptography
end
{{ end -}}
