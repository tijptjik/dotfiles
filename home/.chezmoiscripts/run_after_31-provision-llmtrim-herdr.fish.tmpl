#!/usr/bin/env fish
{{ if .isDesktop -}}

source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"

function llmtrim_herdr_plugin_is_installed
    command herdr plugin list --json | command jq -e \
        '.result.plugins[]? | select(.plugin_id == "llmtrim.proxy")' >/dev/null 2>&1
end

if not command -q herdr
    status_msg WARN "!" "llmtrim [Herdr unavailable]"
    exit 0
end

if not test -S "$HOME/.config/herdr/herdr.sock"
    status_msg WARN "!" "llmtrim [start Herdr, then rerun tjiktup]"
    exit 0
end

if llmtrim_herdr_plugin_is_installed
    status_msg SKIP "✓" "llmtrim Herdr plugin"
    exit 0
end

status_msg CONFIG "..." "llmtrim Herdr plugin"
if command herdr plugin install fkiene/llmtrim-herdr --yes
    status_msg CONFIG "✓" "llmtrim Herdr plugin"
else
    status_msg FAILED "✗" "llmtrim Herdr plugin"
    exit 1
end
{{ end -}}
