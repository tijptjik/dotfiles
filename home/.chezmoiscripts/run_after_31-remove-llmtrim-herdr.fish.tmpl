#!/usr/bin/env fish
if test "$FLEET_DEFER_HOOKS" = 1
    exit 0
end
{{ if .isDesktop -}}

source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"

section_header "Herdr"

function llmtrim_install_record
    cargo install --list | string match -r '^llmtrim v.*'
end

function sync_llmtrim
    if not command -q cargo
        printf 'cargo is not installed\n' >&2
        return 1
    end

    set -l before_record (llmtrim_install_record)
    if test "$FLEET_UPGRADE" != 0; or not llmtrim_install_record >/dev/null; or not command -q llmtrim
        set -l repair_args
        if not command -q llmtrim
            set repair_args --force
        end
        cargo install --locked $repair_args llmtrim; or return $status
    end
    set -l after_record (llmtrim_install_record)

    if test "$before_record" = "$after_record"
        printf '__stage_note__:no changes\n'
    else
        printf '__stage_note__:updated\n'
    end
end

stage_dynamic_note "llmtrim installation" SYNC "llmtrim" sync_llmtrim

# Generate the local CA without modifying a shell profile. Routing is opt-in:
# the `herdr` Fish function supplies this environment only to Herdr and its panes.
function configure_llmtrim
    llmtrim setup --env >/dev/null
    and llmtrim start
end

if test -f "$HOME/.llmtrim/ca.pem"
    status_msg SKIP "✓" "llmtrim" "available"
else
    interactive_stage "llmtrim setup" CONFIG "llmtrim" configure_llmtrim
end

if not command -q herdr
    status_msg WARN "!" "Plugin : LLMTrim [Herdr unavailable]"
    exit 0
end

if not test -S "$HOME/.config/herdr/herdr.sock"
    status_msg WARN "!" "Plugin : LLMTrim [start Herdr, then rerun tjiktup]"
    exit 0
end

if command herdr plugin list --json | command jq -e \
    '.result.plugins[]? | select(.plugin_id == "llmtrim.proxy")' >/dev/null 2>&1
    status_msg SKIP "✓" "Plugin : LLMTrim" "available"
    exit 0
end

status_msg CONFIG "..." "Plugin : LLMTrim"
if command herdr plugin install fkiene/llmtrim-herdr --yes
    status_msg CONFIG "✓" "Plugin : LLMTrim" "available"
else
    status_msg FAILED "✗" "Plugin : LLMTrim" "installation failed"
    exit 1
end
{{ end -}}
