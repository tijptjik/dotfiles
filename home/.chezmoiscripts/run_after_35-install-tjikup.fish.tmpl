#!/usr/bin/env fish
if test "$FLEET_DEFER_HOOKS" = 1
    exit 0
end
source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"

# The same focused installer supports initial provisioning and fleet migration.
stage 'Install tjikup' INSTALL Tjikup bash "{{ .chezmoi.sourceDir }}/../scripts/install-tjikup.sh"
or exit $status
