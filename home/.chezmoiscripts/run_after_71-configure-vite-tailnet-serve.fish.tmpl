#!/usr/bin/env fish
{{ if .isDesktop -}}

source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"

function tailnet_running
    command tailscale status --json 2>/dev/null | command jq -e '.BackendState == "Running"' >/dev/null 2>&1
end

function tailnet_warning --argument-names subject
    set backend (command tailscale status --json 2>/dev/null | command jq -r '.BackendState // "Unavailable"')
    if test "$backend" = NeedsLogin
        __stage_label_note WARN "!" "$subject" "Tailscale login required"
    else
        __stage_label_note WARN "!" "$subject" "tailscale is $backend"
    end
end

function vite_tailnet_route_is_ready
    command tailscale serve status --json 2>/dev/null | command jq -e '
        (.TCP["8443"].HTTPS == true) and
        any(.Web[]?; .Handlers["/"].Proxy == "http://localhost:5173")
    ' >/dev/null 2>&1
end

if not command -q tailscale
    __stage_label WARN "!" "Vite tailnet route [Tailscale unavailable]"
    exit 0
end

if vite_tailnet_route_is_ready
    __stage_label_note SKIP "✓" "Vite tailnet route" "ready at :8443"
    exit 0
end

set restore_tailnet false
if not tailnet_running
    if not command timeout 15s tailscale up >/dev/null 2>&1
        tailnet_warning "Vite tailnet route"
        exit 0
    end
    set restore_tailnet true
end

# The Vite development server on fi binds IPv6 loopback only. `localhost`
# preserves that resolution while avoiding a Tailscale IPv6-literal proxy bug.
if command tailscale serve --https=8443 --bg --yes http://localhost:5173 >/dev/null
    __stage_label_note CONFIG "✓" "Vite tailnet route" "ready at :8443"
else
    __stage_failure "Vite tailnet route"
    if $restore_tailnet
        command tailscale down >/dev/null 2>&1
    end
    exit 1
end

if $restore_tailnet
    command tailscale down >/dev/null 2>&1
end
{{ end -}}
