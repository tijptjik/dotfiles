#!/usr/bin/env fish
source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"

function update_bitwarden_clis
    set -l installer_dir (mktemp -d); or return 1
    set -l installer "$installer_dir/installer.py"
    printf '%s' {{ include ".chezmoitemplates/github_api.py" | b64enc | quote }} | base64 --decode > "$installer_dir/github_api.py"
    and printf '%s' {{ include ".chezmoitemplates/install-bitwarden-cli.py" | b64enc | quote }} | base64 --decode > "$installer"
    set -l write_result $status
    if test $write_result -ne 0
        rm -rf "$installer_dir"
        return $write_result
    end
    python3 -B "$installer"
    set -l result $status
    rm -rf "$installer_dir"
    return $result
end

if not contains -- /usr/local/bin $PATH
    fish_add_path /usr/local/bin; or exit $status
end

status_msg UPDATE "..." "Bitwarden CLIs"
set -l update_output (update_bitwarden_clis 2>&1)
set -l update_result $status
switch $update_result
    case 0
        status_msg UPDATE "✓" "Bitwarden CLIs"
    case 78
        status_msg WARN "!" "Bitwarden CLIs" "release check deferred; managed installs kept"
        printf '%s\n' $update_output
    case '*'
        status_msg FAILED "✗" "Bitwarden CLIs"
        printf '%s\n' $update_output
        exit $update_result
end
