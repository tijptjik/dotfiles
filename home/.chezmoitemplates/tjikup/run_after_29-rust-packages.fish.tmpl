#!/usr/bin/env fish
source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"

section_header "Packages"

set rust_packages serie dysk

function cargo_install_record --argument-names package
    cargo install --list | string match -r "^$package v.*"
end

function sync_rust_packages
    if not command -q cargo
        printf 'cargo is not installed\n' >&2
        return 1
    end

    set -l before_records
    for package in $rust_packages
        set -a before_records "$(cargo_install_record $package)"
    end

    for package in $rust_packages
        if test "$TJIKUP_OPERATION" = update; and not cargo_install_record $package >/dev/null
            continue
        end
        if test "$FLEET_UPGRADE" != 0; or not cargo_install_record $package >/dev/null; or not command -q $package
            set -l repair_args
            if not command -q $package
                set repair_args --force
            end
            cargo install $repair_args $package; or return $status
        end
    end

    set -l update_count 0
    for index in (seq (count $rust_packages))
        set -l after_record "$(cargo_install_record $rust_packages[$index])"
        if test "$before_records[$index]" != "$after_record"
            set update_count (math "$update_count + 1")
        end
    end

    set -l package_count (count $rust_packages)
    set -l note "$package_count pkgs"
    if test $update_count -gt 0
        set note "$note; $update_count updated"
    else
        set note "$note; no changes"
    end

    printf '__stage_note__:%s\n' "$note"
end

stage_dynamic_note "Rust packages" SYNC "Rust" sync_rust_packages
