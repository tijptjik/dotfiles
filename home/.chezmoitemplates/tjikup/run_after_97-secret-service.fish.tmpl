#!/usr/bin/env fish
source "{{ .chezmoi.sourceDir }}/.chezmoihelpers/status.fish"

section_header "Credential Store"

# Fedora 45's standard Secret Service provider, including login unlocking and
# sandboxed application access. Keyring data stays local to each machine.
if not rpm -q oo7-daemon pam_oo7 oo7-portal >/dev/null 2>&1
    stage_note "Credential Store" INSTALL "oo7" installed sudo dnf install -y oo7-daemon pam_oo7 oo7-portal; or exit $status
end

# The old package supplies competing D-Bus activation and login startup paths.
# Removing packages preserves ~/.local/share/keyrings for oo7's migration.
if rpm -q gnome-keyring >/dev/null 2>&1; or rpm -q gnome-keyring-pam >/dev/null 2>&1
    for unit in gnome-keyring-daemon.socket gnome-keyring-daemon.service
        if systemctl --user --quiet is-enabled $unit; or systemctl --user --quiet is-active $unit
            systemctl --user disable --now $unit; or exit $status
        end
    end
    stage_note "Credential Store" REMOVE "GNOME Keyring" "replaced by oo7" sudo dnf remove -y --setopt=clean_requirements_on_remove=False gnome-keyring gnome-keyring-pam; or exit $status
end

# PAM/D-Bus may have launched a daemon outside systemd before package removal.
# Match only this user's GNOME Keyring executable, never arbitrary providers.
pkill -u (id -u) -f '^/usr/bin/gnome-keyring-daemon( |$)'
set -l kill_status $status
if test $kill_status -gt 1
    exit $kill_status
end

systemctl --user daemon-reload; or exit $status
if systemctl --user --quiet is-failed oo7-daemon.service
    systemctl --user reset-failed oo7-daemon.service; or exit $status
end
if not systemctl --user --quiet is-enabled oo7-daemon.service; or not systemctl --user --quiet is-active oo7-daemon.service
    stage_note "Credential Store" CONFIG "oo7 daemon" enabled systemctl --user enable --now oo7-daemon.service; or exit $status
else
    status_msg SKIP "✓" "oo7 daemon" "enabled and running"
end
