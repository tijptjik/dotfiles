  "default": "@ HD/6:BAL | mx HD/6:BAL | mn SD",
  "constraints": [
    "This initial catalogue uses target = maximum and an SD floor. Arbitrary combinations are not implied.",
    "Dictionarry strategies overlap. BAL and EFF are alternatives, not consecutive rungs.",
    "The upgrade target uses the upstream quality group and custom-format cutoff, not a measured bitrate.",
    "Remux is allowed in MAX strategies. Full-disc payloads remain excluded.",
    "No strict codec-adjusted bitrate bands or fixed movie-size caps are added."
  ],
  "sync": {
    "databaseName": "si-media-profiles",
    "profileTrigger": "manual",
    "mediaManagement": [
      "qualityDefinitions"
    ],
    "seerrDefault": "@ HD/6:BAL | mx HD/6:BAL | mn SD",
    "migrateExistingAssignments": false
  }
}
