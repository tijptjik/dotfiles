{
  "theme": "rose-punk",
  "style": {
    "paddingX": 12,
    "paddingY": 10,
    "borderWidth": 0,
    "greyscaleIcons": true,
    "iconSet": "proicons",
    "animateIcons": true
  },
  "layout": {
    "centre_width": "40%"
  },
  "modules": {
    "spaces": {
      "provider": "workspaces",
      "scope": "screen",
      "special": false,
      "occupiedOnly": true,
      "label": "name",
      "preview": {
        "enabled": true,
        "delay": 300,
        "width": 640,
        "slideDuration": 120,
        "closeDelay": 160,
        "refreshInterval": 50,
        "maxWindows": 12
      },
      "style": {
        "iconTextGap": 0,
        "itemGap": 4,
        "states": {
          "active": {
            "color": "#e5e5e5"
          },
          "focused": {
            "color": "#e5e5e5"
          }
        }
      },
      "icon": {
        "style": {
          "minItemSize": 12,
          "iconSize": 12
        }
      },
      "text": {
        "style": {
          "minItemSize": 16
        }
      },
      "appearance": "ring",
      "labels": {
        "10": "X"
      }
    },
    "music": {
      "provider": "playerctl",
      "players": [
        "spotify"
      ],
      "text": {
        "style": {
          "maxTextWidth": 220
        }
      },
      "actions": {
        "rightClick": "player.quit"
      },
      "panel": {
        "hover": true,
        "delay": 300,
        "closeDelay": 200
      },
      "artist": {
        "style": {
          "maxTextWidth": 180,
          "marquee": true
        }
      },
      "track": {
        "style": {
          "maxTextWidth": 300,
          "marquee": true
        }
      }
    },
    "prices": {
      "provider": "crypto",
      "interval": 600,
      "currency": "USD",
      "currencySymbol": "",
      "assets": [
        {
          "symbol": "BTC",
          "price_precision": 0
        },
        {
          "symbol": "SOL",
          "price_precision": 0
        },
        {
          "symbol": "AR",
          "price_precision": 1
        }
      ],
      "items": {
        "BTC/USD": {
          "icon": {
            "actions": {
              "leftClick": "crypto.panel",
              "rightClick": [
                "xdg-open",
                "https://coinmarketcap.com/currencies/bitcoin/"
              ]
            }
          },
          "text": {
            "actions": {
              "leftClick": "crypto.panel",
              "rightClick": [
                "xdg-open",
                "https://www.tradingview.com/symbols/BTCUSD/"
              ]
            }
          }
        }
      },
      "actions": {
        "leftClick": "crypto.panel"
      },
      "panel": {
        "hover": true,
        "delay": 300,
        "closeDelay": 160
      }
    },
    "tray": {
      "provider": "icontray",
      "exclude": [
        "Input Method",
        "solaar",
        "indicator-solaar",
        "spotify*",
        "com.spotify.Client",
        "Mullvad VPN*"
      ],
      "style": {
        "monochromeIcon": false,
        "iconSize": 18,
        "greyscaleIcons": true
      },
      "iconOverrides": {
        "ChatGPT": "builtin:chatgpt-outline",
        "Mullvad VPN_status_icon_*": "builtin:mullvad",
        "TelegramDesktop": "builtin:telegram-outline",
        "ZapZap": "builtin:whatsapp-outline",
        "spotify*": "builtin:spotify",
        "com.spotify.Client": "builtin:spotify",
        "vlc*": "/home/io/.local/share/icons/hicolor/scalable/apps/vlc-outline.svg",
        "org.videolan.VLC": "/home/io/.local/share/icons/hicolor/scalable/apps/vlc-outline.svg"
      }
    },
    "net": {
      "provider": "network",
      "actions": {
        "leftClick": "network.panel",
        "hoverEnter": "network.panel"
      },
      "text": {
        "style": {
          "maxTextWidth": 110,
          "marquee": true
        }
      }
    },
    "vpn": {
      "provider": "mullvad",
      "actions": {
        "leftClick": [
          "mullvad",
          "connect"
        ],
        "rightClick": "tailscale.toggle",
        "middleClick": [
          "mullvad",
          "disconnect"
        ]
      },
      "style": {
        "states": {
          "active": {
            "color": "#e5e5e5"
          }
        }
      },
      "regionFlag": true,
      "panel": {
        "hover": true,
        "delay": 300,
        "closeDelay": 160
      },
      "quickCountries": [
        "nl",
        "jp",
        "sg"
      ]
    },
    "tailnet": {
      "provider": "tailscale",
      "symbol": "vpn_lock",
      "actions": {
        "leftClick": "tailscale.toggle"
      },
      "panel": {
        "hover": true,
        "delay": 300,
        "closeDelay": 160
      }
    },
    "sound": {
      "provider": "audio",
      "icon": {
        "actions": {
          "leftClick": "audio.route"
        }
      },
      "text": {
        "actions": {
          "leftClick": "audio.panel"
        }
      },
      "actions": {
        "scrollUp": "audio.up",
        "scrollDown": "audio.down",
        "middleClick": "audio.mute"
      }
    },
    "time": {
      "provider": "datetime",
      "format": "%H:%M",
      "alternate": "%a %d %b",
      "tooltipFormat": "%A, %d %B %Y",
      "actions": {
        "leftClick": "datetime.toggle"
      },
      "panel": {
        "hover": true,
        "delay": 300,
        "closeDelay": 160
      },
      "worldClocks": [
        {
          "label": "New York",
          "timezone": "America/New_York"
        },
        {
          "label": "London",
          "timezone": "Europe/London"
        },
        {
          "label": "Amsterdam",
          "timezone": "Europe/Amsterdam"
        },
        {
          "label": "Tokyo",
          "timezone": "Asia/Tokyo"
        }
      ]
    },
    "input": {
      "provider": "locale",
      "actions": {
        "leftClick": "locale.cycle",
        "rightClick": {
          "command": [
            "fcitx5-configtool"
          ],
          "detach": true
        }
      },
      "panel": {
        "hover": true,
        "delay": 300,
        "closeDelay": 160
      }
    },
    "quota": {
      "provider": "codex",
      "source": "db",
      "panel": {
        "hover": true,
        "delay": 300,
        "closeDelay": 160
      }
    },
    "credit": {
      "provider": "openrouter",
      "interval": 600,
      "currencySymbol": "",
      "panel": {
        "hover": true,
        "delay": 300,
        "closeDelay": 160
      }
    },
    "notifications": {
      "provider": "DND",
      "actions": {
        "leftClick": "DND.toggle"
      },
      "style": {
        "states": {
          "active": {
            "color": "#e5e5e5"
          }
        }
      }
    },
    "idle": {
      "provider": "caffeine",
      "actions": {
        "leftClick": "caffeine.toggle",
        "middleClick": [
          "systemctl",
          "suspend"
        ]
      },
      "style": {
        "states": {
          "active": {
            "color": "#e5e5e5"
          }
        }
      }
    },
    "filter": {
      "provider": "nightlight",
      "actions": {
        "leftClick": "nightlight.toggle",
        "middleClick": null
      },
      "style": {
        "states": {
          "active": {
            "color": "#e5e5e5"
          }
        }
      }
    },
    "display": {
      "provider": "monitor-layout",
      "actions": {
        "leftClick": "monitor.toggle"
      }
    }
  },
  "perMonitor": {
{{- if not .isLaptop }}
    "DP-2": {
      "modules": {
        "music": {
          "players": [
            "spotify"
          ]
        },
        "spaces": {
          "labels": {
            "11": "1",
            "12": "2",
            "13": "3",
            "14": "4",
            "15": "5",
            "16": "6",
            "17": "7",
            "18": "8",
            "19": "9",
            "20": "X"
          }
        }
      }
    }
{{- end }}
  },
  "bars": [
    {
      "id": "workspace-bar",
      "monitors": {{ if .isLaptop }}"all"{{ else }}["DP-1", "DP-2"]{{ end }},
      "side": "b",
      "position": "l",
      "alignment": "{{ if .isLaptop }}l{{ else }}r{{ end }}",
      "offsetY": -24,
      "islandGap": 10,
      "islands": [
        {
          "id": "markets",
          "modules": [
            "prices"
          ]
        },
        {
          "id": "media",
          "modules": [
            "music"
          ]
        },
        {
          "id": "workspaces",
          "modules": [
            "spaces"
          ]
        }
      ],
      "autoHide": true,
      "activationEdge": "b",
      "activationDelay": 0,
      "hideDelay": 1000,
      "keepVisibleDistance": "140px",
      "fadeDuration": 180,
      "thickness": 44,
      "overflow": "centre",
      "screenGutter": "edgeOffset",
      "perMonitor": {
{{- if not .isLaptop }}
        "DP-2": {
          "islands": [
            {
              "id": "workspaces",
              "modules": [
                "spaces"
              ]
            }
          ]
        }
{{- end }}
      }
    },
    {
      "id": "status-bar",
      "monitors": {{ if .isLaptop }}"all"{{ else }}["DP-1"]{{ end }},
      "side": "b",
      "position": "r",
      "alignment": "{{ if .isLaptop }}r{{ else }}l{{ end }}",
      "offsetY": -24,
      "islandGap": 10,
      "islands": [
        {
          "id": "applications",
          "modules": [
            "tray"
          ]
        },
        {
          "id": "ai",
          "modules": [
            "quota",
            "credit"
          ]
        },
        {
          "id": "connectivity",
          "modules": [
            "net",
            "vpn",
            "tailnet"
          ]
        },
        {
          "id": "audio-clock-input",
          "modules": [
            "sound",
            "time",
            "input"
          ]
        },
        {
          "id": "controls",
          "modules": [
            "notifications",
            "idle",
            "filter",
            "display"
          ]
        }
      ],
      "autoHide": true,
      "activationEdge": "b",
      "activationDelay": 0,
      "hideDelay": 1000,
      "keepVisibleDistance": "140px",
      "fadeDuration": 180,
      "thickness": 44,
      "overflow": "centre",
      "screenGutter": "edgeOffset"
    }
  ]
}
