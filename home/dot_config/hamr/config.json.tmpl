{
  "apps": {
    "terminal": "/bin/kitty",
    "terminalArgs": "--class=floating.terminal",
    "shell": "/bin/fish"
  },
  "imageBrowser": {
    "useSystemFileDialog": false
  },
  "search": {
    "actionKeys": [
      "u",
      "i",
      "o",
      "p"
    ],
    "engineBaseUrl": "https://www.google.com/search?q=",
    "excludedSites": [
      "quora.com",
      "facebook.com"
    ],
    "nonAppResultDelay": 30,
    "prefix": {
      "action": "/",
      "app": ">",
      "clipboard": ";",
      "dict": "?",
      "emojis": ":",
      "file": "~",
      "math": "=",
      "shellCommand": "$",
      "shellHistory": "!"
    },
    "shellHistory": {
      "customHistoryPath": "",
      "enable": true,
      "maxEntries": 500,
      "shell": "auto"
    }
  },
  "behavior": {
    "clickOutsideAction": "close"
  },
  "appearance": {
    "backgroundTransparency": 0,
    "contentTransparency": 0,
    "fontScale": 1.1,
    "launcherYRatio": {{ template "hamr-y-ratio" . }}
  },
  "paths": {
    "wallpaperDir": "~/.local/share/backgrounds/21:9",
    "colorsJson": "~/.config/hamr/colors.json"
  }
}
