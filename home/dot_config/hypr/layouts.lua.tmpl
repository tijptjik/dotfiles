-- #######################
-- MASTER
-- #######################

-- See https://wiki.hypr.land/Configuring/Layouts/Master-Layout/

hl.config({
    master = {
        special_scale_factor = 0.6,
        new_status = "master",
        new_on_top = true,
        orientation = "center",
        slave_count_for_center_master = 2,
{{- if .isDesktop }}
        mfact = 0.5085,
{{- else if .isLaptop }}
        mfact = 0.58,
{{- end }}
    },
})

-- Native scrolling: https://wiki.hypr.land/Configuring/Layouts/Scrolling-Layout/
hl.config({
    scrolling = {
        direction = "right",
        column_width = 0.5,
        fullscreen_on_one_column = false, -- Keep the app width even when alone.
        focus_fit_method = 1, -- Keep adjacent half-width columns visible on focus.
        follow_focus = true,
        follow_min_visible = 0.4,
        explicit_column_widths = "0.333, 0.5, 0.667, 1.0",
        wrap_focus = false,
        wrap_swapcol = false,
    },
})

hl.gesture({ fingers = 3, direction = "horizontal", action = "scroll_move" })
