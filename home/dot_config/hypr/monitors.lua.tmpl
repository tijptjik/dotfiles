-- -*- mode: lua; -*-
-- Sourced in ~/.config/hypr/hyprland.lua
-- #######################
-- HYPRLAND :: MONITORS
-- #######################

-- Author : Mart van de Ven
-- Contact : https://type.hk

-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
{{ if .isDesktop -}}

-- Primary

-- Samsung Odyssey G8
hl.monitor({
    output = "DP-1",
    mode = "3440x1440@119.960999",
    position = "0x0",
    scale = 1,
    bitdepth = 10,
    cm = "auto",
    supports_wide_color = 1,
    supports_hdr = 1,
})

-- Secondary

-- HP23
hl.monitor({
    output = "DP-2",
    mode = "1920x1080@74.97",
    position = "3440x720",
    scale = 1,
    bitdepth = 8,
    cm = "srgb",
})

-- HP23 - Disabled
-- hl.monitor({
--     output = "DP-2",
--     disabled = true,
-- })

-- Tertiary

-- The display-mode commands write this file before reloading Hyprland. Keep
-- it outside the managed configuration so the selected display mode survives
-- a compositor restart without becoming a chezmoi source change.
local state_home = os.getenv("XDG_STATE_HOME") or (os.getenv("HOME") .. "/.local/state")
local mode_file = io.open(state_home .. "/hypr/display-mode", "r")
local game_mode = false

if mode_file ~= nil then
    game_mode = mode_file:read("*l") == "game"
    mode_file:close()
end

if game_mode then
    -- LG TV - 4K, centered on the left edge of the primary display.
    hl.monitor({
        output = "HDMI-A-1",
        mode = "3840x2160@60.00",
        position = "auto-center-left",
        scale = 1,
    })
else
    -- Desktop mode leaves the TV out of the layout.
    hl.monitor({
        output = "HDMI-A-1",
        disabled = true,
    })
end

{{ else if .isLaptop -}}

-- Primary
hl.monitor({
    output = "eDP-1",
    mode = "3840x2400@60.00",
    position = "0x0",
    scale = 2,
})

-- Secondary
hl.monitor({
    output = "DP-2",
    mode = "1920x1080@60.00",
    position = "auto-right",
    scale = 1,
})

{{- end }}
