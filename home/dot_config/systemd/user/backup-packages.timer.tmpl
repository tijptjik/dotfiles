[Unit]
Description=Daily device archives for {{ .chezmoi.hostname }}

[Timer]
{{ if .isDesktop -}}
OnCalendar=*-*-* 00:00:00
{{ else if .isLaptop -}}
OnCalendar=*-*-* 00:15:00
{{ else if .isServer -}}
OnCalendar=*-*-* 00:30:00
{{ end -}}
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true

[Install]
WantedBy=timers.target
