# ~/.config/systemd/user/codex-lb.service
[Unit]
Description=Codex Load Balancer (local runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/io/.codex-lb
ExecStart=/home/io/.codex-lb/runtime/bin/codex-lb
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
