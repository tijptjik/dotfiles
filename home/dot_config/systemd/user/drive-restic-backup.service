[Unit]
Description=Encrypted Restic backup of Google Drive archives and native documents
ConditionHost=si
OnFailure=drive-restic-backup-failure.service

[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=infinity
TimeoutStopSec=120
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/drive-restic-backup
