[Unit]
Description=Hyprfloat daemon
Documentation=https://github.com/nevimmu/hyprfloat
After=graphical-session.target
PartOf=graphical-session.target
ConditionFileIsExecutable=%h/.local/bin/hyprfloat

[Service]
Type=simple
ExecStart=%h/.local/bin/hyprfloat
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
