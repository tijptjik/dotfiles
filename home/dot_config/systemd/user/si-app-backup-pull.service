[Unit]
Description=Copy si application backup to this computer
ConditionHost=fi
OnFailure=si-app-backup-pull-failure.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=%h/.local/bin/si-app-backup-pull
TimeoutStartSec=6h
Restart=on-failure
RestartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
