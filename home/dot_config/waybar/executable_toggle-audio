#!/usr/bin/env bash
set -euo pipefail

# Serialize launch/toggle so rapid clicks cannot race a starting instance.
mode="${1:-toggle}"
if [[ "$mode" == ensure || "$mode" == toggle ]]; then
    config="${2:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/audio}"
else
    config="$mode"
    mode=toggle
fi
exec 9>"${XDG_RUNTIME_DIR:?}/waybar-audio.lock"
flock -x 9
if [[ "$mode" == ensure ]]; then
    if qs ipc -p "$config" call audio isOpen >/dev/null 2>&1; then
        exit 0
    fi
    AUDIO_WIDGET_MODE=ensure qs -d -n -p "$config" 9>&-
    exit 0
fi
anchor="$(python3 "$config/audio.py" anchor)"
if qs ipc -p "$config" call audio toggleAt "$anchor" >/dev/null 2>&1; then
    exit 0
fi
AUDIO_WIDGET_ANCHOR="$anchor" qs -d -n -p "$config" 9>&-
