#!/usr/bin/env bash
set -euo pipefail

# Serialize launch/toggle so rapid clicks cannot race a starting instance.
config="${1:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/network}"
exec 9>"${XDG_RUNTIME_DIR:?}/waybar-network.lock"
flock -x 9
anchor="$(python3 "$config/network.py" anchor)"
if qs ipc -p "$config" call network toggleAt "$anchor" >/dev/null 2>&1; then
    exit 0
fi
NETWORK_WIDGET_ANCHOR="$anchor" qs -d -n -p "$config" 9>&-
