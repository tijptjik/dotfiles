#!/usr/bin/env fish

# Toggle the LG TV while retaining the normal desktop monitor layout.
#
# Game mode adds HDMI-A-1 as a 4K display to the left of the primary DP-1
# monitor. Desktop mode is the configured Hyprland layout (DP-1 and DP-2,
# with the TV disabled). Keep the state derived from Hyprland rather than a
# marker file so the command also works after a reload or reconnect.

set -l tv_output HDMI-A-1
set -l state_home "$HOME/.local/state"

if set -q XDG_STATE_HOME; and test -n "$XDG_STATE_HOME"
    set state_home "$XDG_STATE_HOME"
end

set -l state_file "$state_home/hypr/display-mode"

function tv_is_active --argument-names output
    command hyprctl -j monitors 2>/dev/null \
        | command jq -e --arg output "$output" 'any(.[]; .name == $output and (.disabled | not))' \
        >/dev/null
end

function report_status --argument-names output
    set -l icon ''
    set -l state desktop
    set -l tooltip 'Desktop mode — TV disabled'

    if tv_is_active "$output"
        set icon ''
        set state game
        set tooltip 'Game mode — TV is left of the primary display'
    end

    printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$icon" "$state" "$tooltip"
end

switch "$argv[1]"
    case status
        report_status "$tv_output"
    case toggle
        if tv_is_active "$tv_output"
            exec "$HOME/.local/bin/monitor-desktop-mode"
        end

        command mkdir -p (path dirname "$state_file")
        or begin
            notify-send 'Display mode' 'Could not save the game-mode state.'
            exit 1
        end
        printf 'game\n' > "$state_file"

        if not command hyprctl reload
            command rm -f "$state_file"
            command hyprctl reload
            notify-send 'Display mode' 'Could not enable the TV output.'
            exit 1
        end

        if not tv_is_active "$tv_output"
            command rm -f "$state_file"
            command hyprctl reload
            notify-send 'Display mode' 'The TV output did not become active.'
            exit 1
        end

        notify-send 'Display mode' 'Game mode: TV enabled to the left of the primary display.'
    case ''
        # Preserve the former `modeGame` toggle behaviour for interactive use.
        exec "$HOME/.local/bin/monitor-game-mode" toggle
    case '*'
        echo "Usage: monitor-game-mode [status|toggle]" >&2
        exit 2
end
