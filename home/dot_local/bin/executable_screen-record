#!/usr/bin/env python3
"""Toggle a region, window or monitor recording, with systemd owning the recorder lifecycle."""
import datetime
import fcntl
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import threading

UNIT = "screen-record.service"


def notify(message):
    subprocess.run(["notify-send", "--app-name=Screen recording", "--expire-time=1500",
                    "Screen recording", message], check=False)


def recorder_command(region, output, mode="region"):
    if mode == "window":
        source = ["-w", "portal", "-restore-portal-session", "no"]
    else:
        validate_region(region)
        source = ["-w", "region", "-region", region]
    return ["gpu-screen-recorder", *source,
            "-f", "30", "-k", "h264", "-ac", "aac", "-a", "default_output",
            "-fallback-cpu-encoding", "yes", "-o", str(output)]


def validate_region(region):
    match = re.fullmatch(r"(\d+)x(\d+)\+(-?\d+)\+(-?\d+)", region)
    if not match or int(match[1]) < 2 or int(match[2]) < 2:
        raise ValueError("Select a region at least 2 pixels wide and high")


def toggle(mode="region"):
    if mode not in {"region", "window", "monitor"}:
        raise ValueError("Unknown recording mode")
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    with (runtime / "screen-record-toggle.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        state = subprocess.check_output(["systemctl", "--user", "show", UNIT,
                                         "--property=ActiveState", "--value"], text=True).strip()
        action = "stop" if state in {"active", "activating", "deactivating", "reloading"} else "start"
        if action == "start":
            (runtime / "screen-record-mode").write_text(mode)
            subprocess.run(["systemctl", "--user", "import-environment", "WAYLAND_DISPLAY",
                            "DISPLAY", "HYPRLAND_INSTANCE_SIGNATURE"], check=True)
        subprocess.run(["systemctl", "--user", action, UNIT], check=True)


def countdown(region):
    # Keep GTK in a separate process so cancelling the recording closes the OSD.
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    gi.require_version("GLibUnix", "2.0")
    from gi.repository import Gdk, GLib, GLibUnix, Gtk, GtkLayerShell
    import cairo

    width, height, x, y = map(int, re.fullmatch(r"(\d+)x(\d+)\+(-?\d+)\+(-?\d+)", region).groups())
    window = Gtk.Window()
    window.set_title("Screen recording countdown")
    window.set_default_size(160, 160)
    window.set_app_paintable(True)
    visual = window.get_screen().get_rgba_visual()
    if visual:
        window.set_visual(visual)
    GtkLayerShell.init_for_window(window)
    GtkLayerShell.set_namespace(window, "screen-record-countdown")
    GtkLayerShell.set_layer(window, GtkLayerShell.Layer.OVERLAY)
    GtkLayerShell.set_keyboard_mode(window, GtkLayerShell.KeyboardMode.NONE)
    GtkLayerShell.set_exclusive_zone(window, 0)
    monitor = Gdk.Display.get_default().get_monitor_at_point(x + width // 2, y + height // 2)
    GtkLayerShell.set_monitor(window, monitor)
    label = Gtk.Label(label="3")
    label.set_name("countdown")
    window.add(label)
    css = Gtk.CssProvider()
    css.load_from_data(b"window { background: transparent; } #countdown { color: white; background: transparent; font-size: 96px; font-weight: bold; }")
    Gtk.StyleContext.add_provider_for_screen(window.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    window.connect("realize", lambda widget: widget.get_window().input_shape_combine_region(cairo.Region(), 0, 0))
    window.connect("destroy", Gtk.main_quit)
    remaining = 3

    def tick():
        nonlocal remaining
        remaining -= 1
        if remaining == 0:
            fade_started = GLib.get_monotonic_time()

            def fade():
                elapsed = (GLib.get_monotonic_time() - fade_started) / 300_000
                label.set_opacity(max(0.0, 1.0 - elapsed))
                if elapsed >= 1:
                    # Submit a fully transparent frame before destroying the layer.
                    GLib.timeout_add(100, cancel)
                    return False
                return True

            GLib.timeout_add(16, fade)
            return False
        label.set_text(str(remaining))
        return True

    def cancel():
        window.destroy()
        return False

    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, cancel)
    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, cancel)
    window.show_all()
    GLib.timeout_add(1000, tick)
    Gtk.main()


def record(mode="region"):
    stopped = threading.Event()
    child = None

    def stop(_signum, _frame):
        stopped.set()
        if child is not None and child.poll() is None:
            child.send_signal(signal.SIGINT)

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    region = None
    if mode != "window":
        child = subprocess.Popen(["slurp", *(["-o", "-r"] if mode == "monitor" else []), "-f", "%wx%h+%x+%y"], stdout=subprocess.PIPE, text=True)
        if stopped.is_set():
            child.send_signal(signal.SIGINT)
        region, _ = child.communicate()
        if stopped.is_set() or child.returncode != 0:
            return
        region = region.strip()
        recorder_command(region, "unused.mp4")  # Validate before countdown.
        child = subprocess.Popen(["/usr/bin/python3", str(Path(__file__).resolve()), "countdown", region])
        if stopped.is_set():
            child.send_signal(signal.SIGINT)
        countdown_status = child.wait()
        if stopped.is_set():
            return
        if countdown_status != 0:
            raise RuntimeError("Could not display the countdown")
        # Allow the compositor to finish unmapping/animating the transparent layer.
        if stopped.wait(0.5):
            return
    directory = Path(subprocess.check_output(["xdg-user-dir", "VIDEOS"], text=True).strip())
    if not directory.is_absolute():
        raise RuntimeError("Videos directory is not configured")
    directory.mkdir(parents=True, exist_ok=True)
    output = directory / ("Recording-" + datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S-%f") + ".mp4")
    child = subprocess.Popen(recorder_command(region, output, mode))
    if stopped.is_set():
        child.send_signal(signal.SIGINT)
    code = child.wait()
    if code != 0:
        raise RuntimeError(f"Recorder exited with status {code}; inspect journalctl --user -u {UNIT}")
    if output.is_file() and output.stat().st_size:
        notify(f"Saved {output.name} in {directory}")
    else:
        raise RuntimeError("Recorder did not create a video")


if __name__ == "__main__":
    try:
        if len(sys.argv) == 3 and sys.argv[1] == "countdown":
            countdown(sys.argv[2])
        elif sys.argv[1:] == ["run"]:
            mode_path = Path(os.environ["XDG_RUNTIME_DIR"]) / "screen-record-mode"
            mode = mode_path.read_text().strip() if mode_path.exists() else "region"
            if mode not in {"region", "window", "monitor"}:
                raise ValueError("Unknown recording mode")
            record(mode)
        else:
            if len(sys.argv) > 2:
                raise ValueError("Usage: screen-record [region|window|monitor]")
            toggle(sys.argv[1] if len(sys.argv) == 2 else "region")
    except Exception as exc:
        notify(f"Failed: {exc}")
        raise
