#!/usr/bin/env bash
# Deploy the chezmoi-managed recorder configuration to the system.
set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/system-monitoring"
if ! rpm -q atop >/dev/null 2>&1; then
    sudo dnf install -y atop
fi

changed=0
install_config() {
    local source="$1" destination="$2"
    if ! sudo cmp -s "$source" "$destination"; then
        sudo install -D -o root -g root -m 0644 "$source" "$destination"
        changed=1
    fi
}

install_config "$config_dir/atop" /etc/sysconfig/atop
install_config "$config_dir/atop-service.conf" /etc/systemd/system/atop.service.d/monitoring.conf
sudo systemctl daemon-reload
sudo systemctl enable --now atop.service atop-rotate.timer
if (( changed )); then
    sudo systemctl restart atop.service
fi
sudo systemctl --no-pager status atop.service atop-rotate.timer
