#!/bin/sh
# The executable is supplied explicitly so stable/preview/nightly stay distinct.
set -eu
if [ "$#" -eq 0 ]; then
    echo 'Usage: zed-isolated /path/to/zed [arguments...]' >&2
    exit 2
fi
exec uwsm app -t scope \
    -p MemoryHigh=12G -p MemoryMax=16G -p MemorySwapMax=2G \
    -p OOMPolicy=kill -- "$@"
