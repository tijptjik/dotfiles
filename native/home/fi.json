{
  "version": 1,
  "id": "home-credentials-fi",
  "host": "fi",
  "context": {
    "user": {
      "name": "io",
      "home": "/home/io"
    },
    "is_client": true,
    "anthropic_model_provider": "zai",
    "cargo_registry_secret_id": "ea529b3b-bac7-4e41-9452-b4fe009eb4f3",
    "npm_publish_secret_id": "86208a1d-f5eb-4483-a655-b505003cfd14",
    "github_packages_secret_id": "a034c00d-d742-428f-81be-b505003fe010"
  },
  "bitwarden": {
    "command": [
      "/usr/local/bin/bws"
    ],
    "access_token_file": "{{ user.home }}/.config/bws/environment",
    "cache": {}
  },
  "entries": [
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/fish/conf.d/secrets.fish",
      "source": "templates/fish/conf.d/secrets.fish.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/hyprvoice/config.toml",
      "source": "templates/hyprvoice/config.toml.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/rclone/rclone.conf",
      "source": "templates/rclone/rclone.conf.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/private-storage/restic-password",
      "source": "templates/private-storage/restic-password.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/private-storage/drive.conf",
      "source": "templates/private-storage/drive.conf.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true,
      "create_only": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/private-storage/cloudflare-backup-token",
      "source": "templates/private-storage/cloudflare-backup-token.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/private-storage/cloudflare-config-token",
      "source": "templates/private-storage/cloudflare-config-token.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/runtjik/amo.env",
      "source": "templates/runtjik/amo.env.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true,
      "group": "runtjik-amo"
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.cargo/credentials.toml",
      "source": "templates/cargo/credentials.toml.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true,
      "group": "cargo-registry",
      "when": "is_client and cargo_registry_secret_id is defined and cargo_registry_secret_id != \"\""
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.npmrc",
      "source": "templates/npm/npmrc.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true,
      "group": "npm-registry",
      "when": "is_client and npm_publish_secret_id is defined and npm_publish_secret_id != \"\""
    }
  ]
}
