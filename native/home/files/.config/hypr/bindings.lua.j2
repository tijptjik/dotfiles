-- #######################
-- KEY BINDINGS : SCREENSHOTS
-- #######################

{%- if is_desktop %}
local screenshot_prepare = "hyprctl eval 'hl.monitor({output=\"DP-1\",sdrbrightness=0.8})';"
local screenshot_restore = ";hyprctl reload"
{%- else %}
local screenshot_prepare = ""
local screenshot_restore = ""
{%- endif %}
hl.bind(super("P"), hl.dsp.exec_cmd(screenshot_prepare .. "hyprshot -o ~/media/images/screenshots -m region --clipboard-only --freeze --silent" .. screenshot_restore))
hl.bind(super("P", "CTRL"), hl.dsp.exec_cmd(screenshot_prepare .. "hyprshot -o ~/media/images/screenshots -m window --clipboard-only --freeze --silent" .. screenshot_restore))
hl.bind(super("P", "SHIFT"), hl.dsp.exec_cmd(screenshot_prepare .. "hyprshot -o ~/media/images/screenshots -m region --freeze --silent" .. screenshot_restore))
hl.bind(super("P", "SHIFT", "CTRL"), hl.dsp.exec_cmd(screenshot_prepare .. "hyprshot -o ~/media/images/screenshots -m window --freeze --silent" .. screenshot_restore))

