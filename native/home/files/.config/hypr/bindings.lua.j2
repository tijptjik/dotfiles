-- -*- mode: lua; -*-
-- Sourced in ~/.config/hypr/hyprland.lua
-- #######################
-- KEY BINDINGS
-- #######################

local super_mod = "SUPER"
local tools = "$HOME/.tools"
local config = "$HOME/.config"
local helpers = require("helpers")
local scrolling_shortcuts = require("scrolling_shortcuts")
require("workspace_reminder").start()

-- #######################
-- KEY BINDINGS : UTILS
-- #######################

local function bind_key(key, ...)
    local modifiers = { ... }
    if #modifiers == 0 then
        return key
    end

    return table.concat(modifiers, " + ") .. " + " .. key
end

local function super(key, ...)
    return bind_key(key, super_mod, ...)
end

local function ctrl(key, ...)
    return bind_key(key, "CTRL", ...)
end

local function shift(key, ...)
    return bind_key(key, "SHIFT", ...)
end

-- See https://wiki.hypr.land/Configuring/Basics/Binds/
-- Note : Key mappings are managed with QMK

-- Global Application Shortcuts -- i.e. call an application shortcut without focus
hl.bind(super("R"), hl.dsp.pass({ window = "class:^(com\\.obsproject\\.Studio)$" }))

-- #######################
-- KEY BINDINGS : EXIT
-- #######################

-- Close
hl.bind(super("Q"), hl.dsp.window.close())

-- Lock
{%- if is_client %}
hl.bind(super("L"), hl.dsp.exec_cmd("$HOME/.local/bin/tailscale-lock --grace 5"))
{%- else %}
hl.bind(super("L"), hl.dsp.exec_cmd("hyprlock --grace 5"))
{%- endif %}
{%- if is_laptop %}
hl.bind("XF86AudioMedia", hl.dsp.exec_cmd("hyprlock --config " .. config .. "/hypr/hyprlock.conf --grace 5"))
{%- endif %}

-- Exit
hl.bind(super("Q", "SHIFT"), hl.dsp.exit())

-- #######################
-- KEY BINDINGS : WINDOW MANAGEMENT
-- #######################

-- Switch the default layout for an immediate scrolling/master comparison.
hl.bind(super("F6"), function() hl.config({ general = { layout = "scrolling" } }) end)
hl.bind(super("F7"), function() hl.config({ general = { layout = "master" } }) end)
-- Show the active column and its neighbor as an equal split.
hl.bind(super("Page_Up"), function() scrolling_shortcuts.pair("l") end)
hl.bind(super("Page_Down"), function() scrolling_shortcuts.pair("r") end)
-- Scrolling viewport controls.
hl.bind(super("Home"), hl.dsp.layout("fit active"))
hl.bind(super("End"), hl.dsp.layout("fit all"))
hl.bind(super("mouse_up", "ALT"), hl.dsp.layout("move -col"))
hl.bind(super("mouse_down", "ALT"), hl.dsp.layout("move +col"))

-- Layout (master-specific controls)
-- Swaps the current window with master. If the current window is the master, swaps it with the first child.
hl.bind(super("Delete"), hl.dsp.layout("swapwithmaster"))
-- Adds a master to the master side.
hl.bind(super("Delete", "ALT"), hl.dsp.layout("addmaster"))
-- Removes a master from the master side.
hl.bind(super("Delete", "SHIFT"), hl.dsp.layout("removemaster"))
-- Grow to fill available space, or not.
hl.bind(super("O"), hl.dsp.window.pseudo())
-- Toggle full screen.
hl.bind(super("F"), hl.dsp.window.fullscreen({ mode = "maximized" }))

-- Focus adjacent columns, or windows within the current column.
hl.bind(super("Left"), function() require("scrolling_gaps").focus("l") end)
hl.bind(super("Right"), function() require("scrolling_gaps").focus("r") end)
hl.bind(super("Up"), hl.dsp.layout("focus u"))
hl.bind(super("Down"), hl.dsp.layout("focus d"))

-- Reorder entire columns horizontally; reorder windows vertically with wrapping.
hl.bind(super("Left", "SHIFT"), function() scrolling_shortcuts.move_column("l") end)
hl.bind(super("Right", "SHIFT"), function() scrolling_shortcuts.move_column("r") end)
hl.bind(super("Up", "SHIFT"), function() scrolling_shortcuts.reorder("u") end)
hl.bind(super("Down", "SHIFT"), function() scrolling_shortcuts.reorder("d") end)

-- Transfer into an existing adjacent column, or extract into a new column.
hl.bind(super("Left", "CTRL"), function() scrolling_shortcuts.transfer("l") end)
hl.bind(super("Right", "CTRL"), function() scrolling_shortcuts.transfer("r") end)
hl.bind(super("Left", "SHIFT", "CTRL"), function() scrolling_shortcuts.extract("l") end)
hl.bind(super("Right", "SHIFT", "CTRL"), function() scrolling_shortcuts.extract("r") end)

-- Absolute column widths.
hl.bind(super("Up", "ALT"), function() require("scrolling_gaps").resize(1.0) end)
hl.bind(super("Right", "ALT"), function() require("scrolling_gaps").resize(0.75) end)
hl.bind(super("Down", "ALT"), function() require("scrolling_gaps").resize(0.5) end)
hl.bind(super("Left", "ALT"), function() require("scrolling_gaps").resize(0.25) end)

-- Cycle Window
hl.bind(super("TAB"), hl.dsp.window.swap({ next = true }))
hl.bind(super("TAB", "SHIFT"), hl.dsp.window.swap({ prev = true }))

-- Window Mouse Manipulation
hl.bind(super("mouse:272"), helpers.panel_aware_drag)
hl.bind(super("mouse:273"), hl.dsp.window.resize())

