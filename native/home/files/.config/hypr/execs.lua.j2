-- -*- mode: lua; -*-
-- Sourced in ~/.config/hypr/hyprland.lua
-- #######################
-- HYPRLAND :: STARTUP
-- #######################

-- Author : Mart van de Ven
-- Contact : https://type.hk

local helpers = require("helpers")
local startup = {}

-- Autologin starts applications while Hyprlock is still waiting for a password.
-- Do not let concurrent Secret Service requests queue their own unlock dialogs.
local function start_after_unlock(command)
    hl.exec_cmd("$HOME/.local/bin/after-keyring-unlock sh -c " .. "'" .. command:gsub("'", "'\"'\"'") .. "'")
end

-- Register this immediately so it also takes effect after a config reload.
helpers.start_zen_workspace_restore()
helpers.start_zen_extensions()
helpers.start_detached_cards()

startup.subscription = hl.on("hyprland.start", function()
    -- GDM 51 otherwise waits ten seconds to register the display. Its Plymouth
    -- quit fallback can restore tty1 and bring the greeter over our locked tty2.
    -- Report compositor readiness immediately, before that fallback expires.
    hl.exec_cmd("if systemctl --quiet is-active gdm.service; then busctl --system --auto-start=no call org.gnome.DisplayManager /org/gnome/DisplayManager/Manager org.gnome.DisplayManager.Manager RegisterDisplay; fi")

    -- Ensure Environment Variables Are Available
    -- hyprlock requires $WAYLAND_DISPLAY to be set in the systemd user environment.
    -- GDM doesn't always propagate this automatically to systemd.
    -- Import these before starting Bartjik so its tray can activate the portal.
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY XMODIFIERS QT_IM_MODULE SDL_IM_MODULE && systemctl --user start hyprvoice.service")

    -- Keep application descendants out of the compositor service cgroup.
    -- Input method: input-method-v2 surfaces stay outside the tiling layout.
    hl.exec_cmd("uwsm app -- fcitx5 -d")

    -- WM
    -- Bartjik is a user service. Its unit starts through Fish so the managed
    -- conf.d environment is available to its providers.
    hl.exec_cmd("systemctl --user start bartjik.service")

    hl.exec_cmd("dconf load /org/gnome/desktop/interface/ < ~/.config/dconf/interface.conf")

    -- VPN
    hl.exec_cmd("mullvad connect")

    -- Night filter
    hl.exec_cmd("systemctl --user start hyprsunset.service")

    -- Clipboard Management
    hl.exec_cmd("uwsm app -- wl-paste --type text --watch cliphist store")
    hl.exec_cmd("uwsm app -- wl-paste --type image --watch cliphist store")

    -- Terminal
    start_after_unlock('uwsm app -- /bin/kitty --title "herdr ~" herdr')

    -- Messengers bypass Mullvad; exclude after uwsm creates the app scope.
    start_after_unlock("uwsm app -- /usr/bin/mullvad-exclude /opt/Telegram/Telegram")
{%- if is_laptop %}
    -- Keep the laptop's other messengers available in the tray at login.
    start_after_unlock("uwsm app -- /usr/bin/mullvad-exclude /bin/zapzap --hideStart")
    start_after_unlock("uwsm app -- /usr/bin/mullvad-exclude flatpak run org.signal.Signal --start-in-tray")
{%- else %}
    start_after_unlock("uwsm app -- /usr/bin/mullvad-exclude /bin/zapzap")
{%- if is_desktop %}
    start_after_unlock("uwsm app -- /usr/bin/mullvad-exclude flatpak run org.signal.Signal")
{%- endif %}
{%- endif %}
    start_after_unlock("uwsm app -- /bin/chatgpt")

{%- if is_desktop %}
    -- IDE: let Zed restore the previous session's workspaces.
    start_after_unlock("$HOME/.local/bin/zed-preview")


    -- Zen // PWA Sites
    start_after_unlock("uwsm app -- /bin/zen-browser")

    -- Codex LB
    start_after_unlock("uwsm app -- /usr/bin/firefoxpwa site launch 01KVFQER39ASXCZ26D7724G54G")

{%- endif %}

end)

return startup
