[Unit]
Description=Copy si application backup to this computer
ConditionHost=fi
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=%h/.local/bin/synctjik app-pull copy
ExecStopPost=-%h/.local/bin/synctjik app-pull notify
TimeoutStartSec=6h
Restart=on-failure
RestartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
