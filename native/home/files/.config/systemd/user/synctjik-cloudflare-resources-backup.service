[Unit]
Description=Encrypted Cloudflare DNS, KV, and R2 backup
ConditionHost=fi
OnFailure=synctjik-cloudflare-resources-backup-failure.service

[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=infinity
TimeoutStopSec=120
ExecStart=%h/.local/bin/synctjik cloudflare backup
Environment=PYTHONUNBUFFERED=1
