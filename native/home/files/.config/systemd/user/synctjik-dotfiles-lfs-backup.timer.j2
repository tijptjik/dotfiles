[Unit]
Description=Daily Dotfiles LFS backup for {{ hostname }}

[Timer]
{% if is_desktop -%}
OnCalendar=*-*-* 00:00:00
{% elif is_laptop -%}
OnCalendar=*-*-* 00:15:00
{% elif is_server -%}
OnCalendar=*-*-* 00:30:00
{% endif -%}
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true

[Install]
WantedBy=timers.target
