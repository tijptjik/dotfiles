[Unit]
Description=Weekly Tjikup maintenance and Telegram status

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/tjikup-weekly scheduled
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment=GIT_TERMINAL_PROMPT=0
Environment=TJIKUP_TELEGRAM_CONFIG=%h/.config/tjikup/telegram.json
StandardInput=null
TimeoutStartSec=12h
TimeoutStopSec=120
UMask=0077
