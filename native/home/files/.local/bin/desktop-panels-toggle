#!/usr/bin/env python3
"""Toggle Bartjik and notification history from their current shared state."""

import fcntl
import json
import os
from pathlib import Path
import subprocess


def control(name, *args):
    return json.loads(subprocess.check_output(
        [str(Path.home() / '.local/bin' / name), *args], text=True, timeout=5
    ))


def toggle():
    bars = control('bartjikctl', 'bars')['bars']
    history_open = control('notjikctl', 'status')['drawerOpen']
    bar_open = any(bar['visible'] and not bar['concealed'] for bar in bars)
    close = bar_open and history_open
    control('bartjikctl', 'hide-reveal' if close else 'show-reveal')
    control('notjikctl', 'history', 'hide' if close else 'show')


if __name__ == '__main__':
    with (Path(os.environ['XDG_RUNTIME_DIR']) / 'desktop-panels-toggle.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        toggle()
