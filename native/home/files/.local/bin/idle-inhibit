#!/usr/bin/env python3
"""Persist idle inhibition and night filter choices across apply and login."""

import fcntl
import os
from pathlib import Path
import subprocess
import sys
import time


def running(name="hypridle"):
    return subprocess.run(["pgrep", "-x", name], stdout=subprocess.DEVNULL).returncode == 0


def read_state(path):
    try:
        value = path.read_text().strip()
    except FileNotFoundError:
        return None
    if value not in ("on", "off"):
        raise ValueError(f"Invalid desktop-mode setting in {path}")
    return value


def write_state(path, value):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(value + "\n")
    os.replace(temporary, path)


def main():
    nightlight = Path(sys.argv[0]).name.endswith("nightlight")
    mode = "nightlight" if nightlight else "idle-inhibit"
    process = "hyprsunset" if nightlight else "hypridle"
    service = process + ".service"
    if len(sys.argv) != 2 or sys.argv[1] not in ("init", "check", "toggle", "on", "off"):
        sys.exit(f"Usage: {mode} {{init|check|toggle|on|off}}")
    action = sys.argv[1]
    # Match the systemd user unit, independently of a caller's XDG overrides.
    path = Path.home() / ".local/state" / mode / "state"
    if action == "check":
        # ExecCondition must not wait for the lock held by `off` while starting
        # the service. Atomic replacement makes this read safe without a lock.
        state = read_state(path)
        blocked = state == "off" if nightlight else state == "on"
        return 1 if blocked else 0
    path.parent.mkdir(parents=True, exist_ok=True)
    with (path.parent / "lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read_state(path)
        if action == "init":
            if state is None:
                active_session = subprocess.run(
                    ["systemctl", "--user", "--quiet", "is-active", "graphical-session.target"]
                ).returncode == 0
                # Adopt an existing session's choice; keep the historical
                # automatic-idle default for a first, headless installation.
                enabled = running(process) if active_session else True
                selected = enabled if nightlight else not enabled
                write_state(path, "on" if selected else "off")
            return 0
        # Toggle what the bar actually displays, including legacy processes.
        selected = (not running(process) if nightlight else running(process)) if action == "toggle" else action == "on"
        write_state(path, "on" if selected else "off")
        subprocess.run(["systemctl", "--user", "stop", service], check=True)
        # Older bar versions started these processes outside systemd.
        result = subprocess.run(["pkill", "-x", process])
        if result.returncode not in (0, 1):
            raise RuntimeError(f"Could not stop the unmanaged {process} process")
        # pkill only sends the signal. Wait for the old process/socket to go
        # away before reporting off or starting its systemd replacement.
        for _ in range(60):
            if not running(process):
                break
            time.sleep(0.05)
        else:
            raise RuntimeError(f"{process} did not stop within three seconds")
        should_run = selected if nightlight else not selected
        if should_run:
            subprocess.run(["systemctl", "--user", "start", service], check=True)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
