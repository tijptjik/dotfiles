#!/usr/bin/env python3
"""Reveal ChatGPT's special workspace without toggling a visible workspace off."""
import json
import subprocess


def reveal_commands(monitors, clients):
    client = next((c for c in clients if c.get("class", "").lower() == "chatgpt"
                   and c.get("workspace", {}).get("name") == "special:codex"), None)
    if client is None:
        return []
    monitor = next((m for m in monitors if m["id"] == client["monitor"]), None)
    if monitor is None:
        return []
    commands = ['hl.dispatch(hl.dsp.focus({monitor=' + json.dumps(monitor["name"]) + '}))']
    if monitor.get("specialWorkspace", {}).get("name") != "special:codex":
        commands.append('hl.dispatch(hl.dsp.workspace.toggle_special("codex"))')
    commands.append('local w=hl.get_window(' + json.dumps(client["address"]) +
                    '); if w then hl.dispatch(hl.dsp.focus({window=w})) end')
    return commands


def main():
    monitors = json.loads(subprocess.check_output(["hyprctl", "-j", "monitors"], text=True))
    clients = json.loads(subprocess.check_output(["hyprctl", "-j", "clients"], text=True))
    commands = reveal_commands(monitors, clients)
    if commands:
        subprocess.run(["hyprctl", "eval", "; ".join(commands)], check=True)


if __name__ == "__main__":
    main()
