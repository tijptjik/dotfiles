{
  "version": 1,
  "id": "home-credentials-li",
  "host": "li",
  "context": {
    "user": {
      "name": "io",
      "home": "/home/io"
    },
    "is_client": true,
    "anthropic_model_provider": "zai",
    "cargo_registry_secret_id": "ea529b3b-bac7-4e41-9452-b4fe009eb4f3"
  },
  "bitwarden": {
    "command": [
      "/usr/local/bin/bws"
    ],
    "access_token_file": "{{ user.home }}/.config/bws/environment",
    "cache": {}
  },
  "entries": [
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/fish/conf.d/secrets.fish",
      "source": "templates/fish/conf.d/secrets.fish.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/hyprvoice/config.toml",
      "source": "templates/hyprvoice/config.toml.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/rclone/rclone.conf",
      "source": "templates/rclone/rclone.conf.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/private-storage/restic-password",
      "source": "templates/private-storage/restic-password.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/private-storage/drive.conf",
      "source": "templates/private-storage/drive.conf.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true,
      "create_only": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.cargo/credentials.toml",
      "source": "templates/cargo/credentials.toml.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true,
      "group": "cargo-registry",
      "when": "is_client and cargo_registry_secret_id is defined and cargo_registry_secret_id != \"\""
    }
  ]
}
