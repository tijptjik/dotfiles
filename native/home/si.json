{
  "version": 1,
  "id": "home-credentials-si",
  "host": "si",
  "context": {
    "user": {
      "name": "m",
      "home": "/home/m"
    },
    "is_client": false,
    "anthropic_model_provider": "zai"
  },
  "bitwarden": {
    "command": [
      "/usr/local/bin/bws"
    ],
    "access_token_file": "{{ user.home }}/.config/bws/environment",
    "cache": {}
  },
  "entries": [
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/drive-restic/drive.conf",
      "source": "templates/drive-restic/drive.conf.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true,
      "create_only": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.config/drive-restic/restic-password",
      "source": "templates/drive-restic/restic-password.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true
    },
    {
      "kind": "file",
      "path": "{{ user.home }}/.cargo/credentials.toml",
      "source": "templates/cargo/credentials.toml.j2",
      "template": true,
      "mode": "0600",
      "sensitive": true,
      "group": "cargo-registry",
      "when": "is_client and cargo_registry_secret_id is defined and cargo_registry_secret_id != \"\""
    }
  ]
}
