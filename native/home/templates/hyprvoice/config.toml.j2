# Hyprvoice Configuration
# Generated by hyprvoice onboarding or configure
# Changes are applied immediately without daemon restart.

# Keywords help transcription and LLM spell names/terms correctly
keywords = ["Sherin"]

# Audio Recording Configuration
[recording]
  sample_rate = 16000
  channels = 1
  format = "s16"
  buffer_size = 8192
  device = ""
  channel_buffer_size = 30
  timeout = "5m0s"

# Speech Transcription Configuration
[transcription]
  provider = "codex"
  language = "en"
  model = "gpt-4o-transcribe"
  streaming = false
  threads = 0

# LLM Post-Processing Configuration
[llm]
  enabled = true
  provider = "codex"
  model = "gpt-6-luna"

  [llm.post_processing]
    remove_stutters = true
    add_punctuation = true
    fix_grammar = true
    remove_filler_words = true

  [llm.custom_prompt]
    enabled = false

# Text Injection Configuration
[injection]
  backends = ["ydotool", "wtype", "clipboard"]
  ydotool_timeout = "5s"
  wtype_timeout = "5s"
  clipboard_timeout = "3s"

# Desktop Notification Configuration
[notifications]
  enabled = true
  # Bartjik shows routine recording and processing state in the tray.
  type = "errors"
