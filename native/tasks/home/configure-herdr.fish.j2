#!/usr/bin/env fish
{% if is_desktop -%}
source {{ (repo_dir ~ "/native/helpers/home/status.fish") | fish_quote }}
if not command -q herdr; or not test -S "$HOME/.config/herdr/herdr.sock"
    status_msg SKIP "-" "Herdr local links" "Herdr unavailable"
    exit 0
end
if command herdr plugin list --json | command jq -e --arg root "$HOME/.config/herdr/plugins/local/local-files" '.result.plugins[]? | select(.plugin_id == "local-files" and .enabled == true and .plugin_root == $root)' >/dev/null 2>&1
    status_msg SKIP "✓" "Herdr (local file links)" "available"
else if command herdr plugin link "$HOME/.config/herdr/plugins/local/local-files" --enabled >/dev/null
    status_msg CONFIG "✓" "Herdr (local file links)" "available"
else
    status_msg FAILED "✗" "Herdr (local file links)" "registration failed"
    exit 1
end
{% endif -%}
