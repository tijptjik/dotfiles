#!/usr/bin/env fish
source {{ (home_source ~ "/.chezmoihelpers/status.fish") | fish_quote }}

{% if is_client -%}
function sync_python_environment
    # Tjikup deploys the project files before this recipe runs.
    # They live under ~/.local/share/pytjik.
    #
    # PaddlePaddle supports CPython through 3.13. Request it explicitly so an
    # installed system Python 3.14 does not make the sync unsatisfiable.
    set -l project "$HOME/.local/share/pytjik"
    set -lx UV_PROJECT_ENVIRONMENT "$HOME/.venv"
    set -l before
    if test -x "$UV_PROJECT_ENVIRONMENT/bin/python"
        set before (uv pip list --quiet --python "$UV_PROJECT_ENVIRONMENT/bin/python" --format=json | string collect)
        or return $status
    end
    set -l verb SKIP
    if test "$TJIKUP_OPERATION" = update; or not uv sync --check --offline --project "$project" --python 3.13 --no-python-downloads >/dev/null 2>&1
        set -l upgrade_args
        if test "$TJIKUP_OPERATION" = update
            set upgrade_args --upgrade
        end
        uv sync --project "$project" --python 3.13 $upgrade_args; or return $status
        set verb SYNC
    end

    set -l packages (uv pip list --quiet --python "$UV_PROJECT_ENVIRONMENT/bin/python" --format=json | string collect)
    or return $status
    if test "$before" = "$packages"
        set verb SKIP
    end
    set -l package_count (printf '%s\n' $packages | string match -ra '"name":' | count)
    printf '__stage_verb__:%s\n' "$verb"
    if test "$verb" = SKIP
        printf '__stage_note__:%s pkgs; no changes\n' "$package_count"
    else
        printf '__stage_note__:%s pkgs\n' "$package_count"
    end
end

stage_dynamic_note "Python environment" SYNC "Python" sync_python_environment
{% else -%}
status_msg SKIP "-" "Python" "client only"
{% endif -%}
