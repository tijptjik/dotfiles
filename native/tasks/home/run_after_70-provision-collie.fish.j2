#!/usr/bin/env fish
{% if is_desktop -%}

source {{ (repo_dir ~ "/native/helpers/home/status.fish") | fish_quote }}

section_header "Tailscale Apps"

function tailnet_running
    command tailscale status --json 2>/dev/null | command jq -e '.BackendState == "Running"' >/dev/null 2>&1
end

function tailnet_warning --argument-names subject
    set backend (command tailscale status --json 2>/dev/null | command jq -r '.BackendState // "Unavailable"')
    if test "$backend" = NeedsLogin
        status_msg WARN "!" "$subject" "Tailscale login required"
    else
        status_msg WARN "!" "$subject" "tailscale is $backend"
    end
end

function collie_bridge_is_ready
    systemctl --user is-active --quiet collie
    or return 1

    command tailscale serve status --json 2>/dev/null | command jq -e '
        any(.Web[]?; .Handlers["/"].Proxy == "http://127.0.0.1:18787")
    ' >/dev/null 2>&1
end

if not command -q herdr
    status_msg WARN "!" "Collie [Herdr unavailable]"
    exit 0
end

if not test -S "$HOME/.config/herdr/herdr.sock"
    status_msg WARN "!" "Collie [start Herdr, then rerun tjiktup]"
    exit 0
end

if not command -q tailscale
    status_msg WARN "!" "Collie [Tailscale unavailable]"
    exit 0
end

if collie_bridge_is_ready
    status_msg SKIP "✓" "Collie (bridge)" "ready at :443"
    exit 0
end

if not tailnet_running
    if not command timeout 15s tailscale up >/dev/null 2>&1
        tailnet_warning "Collie"
        exit 0
    end
end

if not sudo loginctl enable-linger "$USER"
    status_msg FAILED "✗" "Collie reboot persistence"
    exit 1
end

if command herdr plugin action invoke restart --plugin herdr.collie >/dev/null
    status_msg CONFIG "✓" "Collie (bridge)" "ready at :443"
else
    status_msg FAILED "✗" "Collie (bridge)"
    exit 1
end

{% endif -%}
