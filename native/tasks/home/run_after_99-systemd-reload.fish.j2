#!/usr/bin/env fish
#
# This script is run by chezmoi on `chezmoi apply`.
# It ensures that systemd user services and timers are reloaded and enabled.
source {{ (home_source ~ "/.chezmoihelpers/status.fish") | fish_quote }}

section_header "Systemd User Units"

{% if is_desktop or is_laptop -%}
# Each client owns its runtime and independently authenticated accounts.
{% if is_desktop -%}
if systemctl --user --quiet is-enabled codex-lb-laptop.service 2>/dev/null; or systemctl --user --quiet is-active codex-lb-laptop.service 2>/dev/null
    systemctl --user disable --now codex-lb-laptop.service; or exit $status
end
{% else -%}
# Release port 2455 before starting the laptop's local backend.
if systemctl --user --quiet is-enabled codex-lb-client.socket 2>/dev/null; or systemctl --user --quiet is-active codex-lb-client.socket 2>/dev/null
    systemctl --user disable --now codex-lb-client.socket; or exit $status
end
if systemctl --user --quiet is-active codex-lb-client.service 2>/dev/null
    systemctl --user stop codex-lb-client.service; or exit $status
end
{% endif -%}

if not systemctl --user --quiet is-enabled codex-lb.service; or not systemctl --user --quiet is-active codex-lb.service
    systemctl --user enable --now codex-lb.service; or exit $status
end
{% endif -%}

function user_units_need_reload
    set -l need_reload (systemctl --user show '*' --property=NeedDaemonReload --value 2>/dev/null)
    contains -- yes $need_reload
end

function unit_needs_enable_now
    set -l unit $argv[1]
    if not systemctl --user --quiet is-enabled "$unit" 2>/dev/null
        return 0
    end
    if not systemctl --user --quiet is-active "$unit" 2>/dev/null
        return 0
    end
    return 1
end

function units_need_enable_now
    for unit in $argv
        if unit_needs_enable_now "$unit"
            return 0
        end
    end
    return 1
end

function configure_common_user_units
    loginctl enable-linger (id -un); or return $status
    systemctl --user daemon-reload
    # The timer stays enabled; ExecCondition gates backups when initial sync is required.
    systemctl --user enable backup-packages.timer
    systemctl --user restart backup-packages.timer
end

if user_units_need_reload; or unit_needs_enable_now backup-packages.timer
    stage_note "Systemd User Units [Common]" CONFIG "Backup schedule" configured configure_common_user_units
else
    status_msg SKIP "✓" "Backup schedule" "no changes"
end

{% if is_client -%}

# Adopt the current idle choice once, then preserve it across applies/logins.
# Never start hypridle during apply: an inactive daemon can be intentional.
"$HOME/.local/bin/idle-inhibit" init; or exit $status
if not systemctl --user --quiet is-enabled hypridle.service
    systemctl --user enable hypridle.service; or exit $status
end
"$HOME/.local/bin/nightlight" init; or exit $status
if not systemctl --user --quiet is-enabled hyprsunset.service
    systemctl --user enable hyprsunset.service; or exit $status
end

set client_services "hyprpolkitagent.service" "hyprpaper.service"

function configure_client_user_units
    # Enabling a graphical helper must not create a session during SSH/apply.
    # In particular hyprpaper Requires=graphical-session.target; --now would
    # activate an empty session that UWSM then refuses to replace at login.
    set -l start_now 0
    if systemctl --user --quiet is-active graphical-session.target
        if systemctl --user show-environment | string match -qr '^WAYLAND_DISPLAY=.'
            set start_now 1
        end
    end
    for service in $argv
        systemctl --user enable $service; or return $status
        if test $start_now -eq 1
            systemctl --user start $service; or return $status
        end
    end
    if test $start_now -eq 0
        status_msg SKIP "-" "Desktop services" "waiting for graphical login"
    end
end

if user_units_need_reload; or units_need_enable_now $client_services
    stage_note "Systemd User Units [Clients]" CONFIG "Desktop session services" configured configure_client_user_units $client_services
else
    status_msg SKIP "✓" "Desktop session services" "no changes"
end

# Voice capture belongs to the graphical session, not the lingering user manager.
function configure_hyprvoice_unit
    if test -L "$HOME/.config/systemd/user/default.target.wants/hyprvoice.service"
        systemctl --user reenable hyprvoice.service; or return $status
    else if not systemctl --user --quiet is-enabled hyprvoice.service
        systemctl --user enable hyprvoice.service; or return $status
    end
    if not test -x "$HOME/.local/bin/hyprvoice"
        status_msg SKIP "-" "Hyprvoice" "not installed"
        return 0
    end
    if not systemctl --user show-environment | string match -qr '^WAYLAND_DISPLAY=.'
        status_msg SKIP "-" "Hyprvoice" "waiting for Wayland"
        return 0
    end
    if systemctl --user --quiet is-active hyprvoice.service
        status_msg SKIP "✓" "Hyprvoice" "running"
        return 0
    end
    stage_note "Hyprvoice" CONFIG "Hyprvoice" started systemctl --user start hyprvoice.service
end

configure_hyprvoice_unit; or exit $status

# This unit is deliberately enabled without --now: starting it during a
# chezmoi apply would lock the currently active graphical session.  systemd
# starts it automatically with graphical-session.target on the next login.
function configure_hyprlock_login_unit
    systemctl --user enable hyprlock-login.service
end

if user_units_need_reload; or not systemctl --user --quiet is-enabled hyprlock-login.service 2>/dev/null
    stage_note "Systemd User Unit [Hyprlock Login]" CONFIG "Hyprlock" configured configure_hyprlock_login_unit
else
    status_msg SKIP "✓" "Hyprlock" "no changes"
end

{%- endif %}

{% if hostname == "fi" -%}
# Only activate after the first backup and isolated restore have been verified.
# The backup itself rejects a missing, wrong, or read-only target mount.
if test -f "$HOME/.local/state/cloudflare-restic/restore-verified.json"; and test -f "$HOME/.config/private-storage/cloudflare-backup-token"; and test -f "$HOME/.config/private-storage/cloudflare-config-token"; and test -f "$HOME/.config/private-storage/restic-password"
    if user_units_need_reload; or unit_needs_enable_now cloudflare-restic-backup.timer
        systemctl --user daemon-reload; or exit $status
        stage_note "Synctjik (Cloudflare backup)" CONFIG "Synctjik (Cloudflare backup)" enabled systemctl --user enable --now cloudflare-restic-backup.timer
    else
        status_msg SKIP "✓" "Synctjik (Cloudflare backup)" "scheduled"
    end
else
    status_msg SKIP "-" "Synctjik (Cloudflare backup)" "setup pending"
end
{% endif -%}
{% if hostname == "si" -%}
# Enable the Drive snapshot timer only after both the create-once OAuth config
# and Restic password have been provisioned. This leaves existing rclone/R2
# configuration untouched.
if test -f "$HOME/.config/drive-restic/drive.conf"; and test -f "$HOME/.config/drive-restic/restic-password"; and test -f "$HOME/.local/state/drive-restic/last-success.json"
    if user_units_need_reload; or unit_needs_enable_now drive-restic-backup.timer
        systemctl --user daemon-reload; or exit $status
        stage_note "Google Drive backup" CONFIG "Daily Restic backup" enabled systemctl --user enable --now drive-restic-backup.timer
    else
        status_msg SKIP "✓" "Google Drive backup" "scheduled"
    end
else
    status_msg SKIP "-" "Google Drive backup" "credentials or first verified backup pending"
end
{% endif -%}

# All installers finish before this hook in tjikup. Refresh changed active
# runtimes as well as unit definitions; daemon-reload alone cannot do that.
stage_dynamic_note 'Service runtimes' RESTART 'User services' python3 {{ (home_source ~ "/../scripts/refresh-user-services.py") | fish_quote }}
or exit $status
