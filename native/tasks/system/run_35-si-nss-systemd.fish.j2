#!/usr/bin/env fish
{% if os == "linux" and is_server -%}
# GDM 50 greeters use transient user records, including shadow entries.
set fedora_release (rpm -E %fedora)
if string match -qr '^[0-9]+$' -- "$fedora_release"; and test "$fedora_release" -ge 44
    {{ include("helpers/status.fish") }}
    {{ include("templates/fish_logging.fish") }}
    setup_logging si-nss-systemd
    set tjikup_stage CHECK
    step_run_note_quiet "Shadow lookups" configured sudo /usr/local/lib/tjikup/tjikup system nss --apply
    or exit 1
end
{% endif -%}
