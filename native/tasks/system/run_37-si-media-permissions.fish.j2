#!/usr/bin/env fish
{% if os == "linux" and is_server -%}
{{ include("helpers/status.fish") }}
{{ include("templates/fish_logging.fish") }}
setup_logging si-media-permissions
if sudo /usr/local/lib/tjikup/tjikup system storage --check >/dev/null 2>&1
    step_run_note_as CHECK "Media (permissions)" loaded sudo systemctl daemon-reload
    or exit 1
    step_run_note_as CHECK "Media (permissions)" enabled sudo systemctl enable --now si-media-permissions.timer
    or exit 1
else
    step_skip_ok "Media (permissions)" "storage not provisioned"
end
{% endif -%}
