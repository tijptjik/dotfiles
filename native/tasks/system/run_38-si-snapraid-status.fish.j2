#!/usr/bin/env fish
{% if os == "linux" and is_server -%}
{{ include("helpers/status.fish") }}
# Package presence and mounted disks do not prove content-format compatibility.
# This command only reads state; it never syncs, scrubs, repairs or converts it.
set -l report (sudo /usr/local/bin/synctjik snapraid status 2>&1)
set -l result $status
switch $result
    case 0
        status_msg CHECK "✓" "SnapRAID metadata" "readable"
    case 75
        status_msg SKIP "✓" "SnapRAID metadata" "maintenance in progress"
    case '*'
        printf '%s\n' $report
        status_msg FAILED "✗" "SnapRAID metadata" "check failed"
        exit $result
end
{% endif -%}
