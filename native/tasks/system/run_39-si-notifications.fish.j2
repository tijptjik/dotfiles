#!/usr/bin/env fish
{% if os == "linux" and is_server -%}
{{ include("helpers/status.fish") }}
{{ include("templates/fish_logging.fish") }}
setup_logging si-notifications
if sudo test -f /etc/si-notifications/telegram.json
    step_run_note_as CHECK "SnapRAID (notifications)" loaded sudo systemctl daemon-reload
    or exit 1
    step_run_note_as CHECK "SnapRAID (notifications)" enabled sudo systemctl enable --now si-snapraid-health.timer
    or exit 1
else
    step_skip_ok "SnapRAID (notifications)" "restore root-only credentials first"
end
{% endif -%}
