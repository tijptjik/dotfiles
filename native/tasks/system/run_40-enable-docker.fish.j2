#!/usr/bin/env fish
# Run on every apply so Docker state is reported in its configured position.

{{ include("helpers/status.fish") }}
{{ include("templates/fish_logging.fish") }}
setup_logging linux-enable-docker

step_header "Docker"

# Add the interactive user only when necessary. `root` does not benefit from
# docker-group membership, so it deliberately has no status line.
set docker_user "$SUDO_USER"
if test -z "$docker_user"; or test "$docker_user" = root
    set docker_user "$USER"
end
if test "$docker_user" != root
    if not id -nG "$docker_user" | string split ' ' | string match -q -- docker
        step_run_note "Group membership for $docker_user" configured sudo usermod -aG docker "$docker_user"
        or exit 1
    end
end

if systemctl is-enabled docker >/dev/null 2>&1; and systemctl is-active docker >/dev/null 2>&1
    step_skip_ok "Docker" "enabled and active"
else
    step_run_note "Docker" "enabled and active" sudo systemctl enable --now docker
    or exit 1
end
