#!/usr/bin/env fish
{% if os == "linux" and is_client -%}
{{ include(".chezmoihelpers/desktop-user.fish") }}
{{ include(".chezmoihelpers/status.fish") }}
{{ include(".chezmoitemplates/fish_logging.fish") }}
setup_logging linux-install-terminal-tools

function install_terminal_tools
    set -l installer_dir (mktemp -d); or return 1
    set -l installer "$installer_dir/installer.py"
    printf '%s' {{ include(".chezmoitemplates/github_api.py") | b64enc | json_quote }} | base64 --decode > "$installer_dir/github_api.py"
    and printf '%s' {{ include(".chezmoitemplates/update-client-cli-releases.py") | b64enc | json_quote }} | base64 --decode > "$installer"
    set -l write_result $status
    if test $write_result -ne 0
        rm -rf "$installer_dir"
        return $write_result
    end
    set -l selected terminal
    if set -q TJIKUP_TERMINAL_TOOL
        set selected "$TJIKUP_TERMINAL_TOOL"
    end
    python3 -B "$installer" "$selected"
    set -l result $status
    rm -rf "$installer_dir"
    return $result
end

set -l title "Tennis and Tinty"
if set -q TJIKUP_TERMINAL_TOOL
    set title (string sub -l 1 "$TJIKUP_TERMINAL_TOOL" | string upper)(string sub -s 2 "$TJIKUP_TERMINAL_TOOL")
end
step_run_quiet "$title" install_terminal_tools
or exit $status
{% endif -%}
