#!/usr/bin/env fish
# Converge persistent tailnet availability after application networking.
{% if os == "linux" -%}

{{ include(".chezmoihelpers/status.fish") }}
{{ include(".chezmoitemplates/fish_logging.fish") }}
setup_logging linux-enable-tailscale
set -g chezetc_stage CONFIG

step_header "Tailscale"

if not command -q tailscale
    step_warn "Tailscale package is unavailable"
    exit 0
end

if systemctl is-enabled --quiet tailscaled; and systemctl is-active --quiet tailscaled
    step_skip_ok "Tailscale daemon" enabled
else
    step_run_note "Tailscale daemon" enabled sudo systemctl enable --now tailscaled
    or exit 1
end

set -l tailscale_prefs (sudo tailscale debug prefs 2>/dev/null)
or begin
    step_fail "Tailscale preferences unavailable"
    exit 1
end

if not printf '%s\n' $tailscale_prefs | jq -e 'type == "object"' >/dev/null 2>&1
    step_fail "Invalid Tailscale preferences"
    exit 1
end

{% if is_client -%}
# Keep enrolled client devices current independently of the next Tjikup run.
if printf '%s\n' $tailscale_prefs | jq -e '.AutoUpdate.Apply == true' >/dev/null
    step_skip_ok "Tailscale auto-update" enabled
else
    step_run_note "Tailscale auto-update" enabled sudo tailscale set --auto-update
    or exit 1
end
{% endif -%}

# Permit the interactive user and user services (including Collie) to manage
# Serve without giving them general sudo access.  A Chezetc system apply may
# itself run under sudo, so preserve the account that invoked sudo rather than
# assigning this role to root.
set -l tailscale_operator "$SUDO_USER"
if test -z "$tailscale_operator"
    set tailscale_operator (id -un)
end
set -l configured_tailscale_operator (printf '%s\n' $tailscale_prefs | jq -r '.OperatorUser // empty' 2>/dev/null)
if test "$configured_tailscale_operator" = "$tailscale_operator"
    step_skip_ok "Tailscale operator for $tailscale_operator" available
else
    step_run_note "Tailscale operator for $tailscale_operator" available sudo tailscale set --operator=$tailscale_operator
    or exit 1
end

{% if is_client -%}
# Keep ordinary DNS and default routes with Mullvad. Fleet SSH discovers peers
# through the local Tailscale API and prefers their IPv6 ULA addresses.
if printf '%s\n' $tailscale_prefs | jq -e '.CorpDNS == false and .RouteAll == false' >/dev/null
    step_skip_ok "Tailnet DNS and routes" configured
else
    step_run_note "Tailnet DNS and routes" configured sudo tailscale set --accept-dns=false --accept-routes=false
    or exit 1
end
set -l tailscale_state (tailscale status --json 2>/dev/null | jq -r '.BackendState // empty' 2>/dev/null)
switch "$tailscale_state"
    case Running
        step_skip_ok "Tailnet connection" available
    case Stopped
        step_run_note "Tailnet connection" connected sudo timeout 20s tailscale up
        or exit 1
    case NeedsLogin NeedsMachineAuth
        step_warn "Tailnet enrollment required; run tailscale up as the desktop user"
    case '*'
        step_fail "Tailnet connection is unavailable ($tailscale_state)"
        exit 1
end
{% endif -%}
{% endif -%}
