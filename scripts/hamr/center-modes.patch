+    /// Keep the saved horizontal center when a mode changes the allocated width.
+    /// After-paint observes GTK's actual allocation, including cards and forms;
+    /// unlike a tick callback it does not keep an idle launcher repainting.
+    fn setup_horizontal_anchor(&self) {
+        let root = self.launcher_root.downgrade();
+        let layout = self.layout_fixed.downgrade();
+        let preview = self.preview_window.window.downgrade();
+        let revealer = self.preview_window.revealer.downgrade();
+        let drag_state = self.drag_state.clone();
+        let state_manager = self.state_manager.clone();
+        self.window.connect_realize(move |window| {
+            let Some(clock) = window.frame_clock() else { return };
+            let root = root.clone();
+            let layout = layout.clone();
+            let preview = preview.clone();
+            let revealer = revealer.clone();
+            let drag_state = drag_state.clone();
+            let state_manager = state_manager.clone();
+            clock.connect_after_paint(move |_| {
+                let (Some(root), Some(layout)) = (root.upgrade(), layout.upgrade()) else {
+                    return;
+                };
+                if !root.is_mapped() || root.width() <= 0 {
+                    return;
+                }
+                let mut drag = drag_state.borrow_mut();
+                if drag.is_dragging {
+                    return;
+                }
+                let ratio = drag.monitor_name.as_deref().map_or_else(
+                    || state_manager.launcher().x_ratio,
+                    |name| state_manager.launcher_position_for_monitor(name).x_ratio,
+                );
+                let left = horizontal_anchor_left(ratio, drag.screen_width, root.width());
+                if left != drag.current_left {
+                    drag.current_left = left;
+                    layout.move_(&root, f64::from(left), f64::from(drag.current_top));
+                }
+                if let (Some(preview), Some(revealer)) = (preview.upgrade(), revealer.upgrade()) {
+                    Self::reposition_preview(
+                        &preview, &revealer, left, drag.current_top,
+                        drag.screen_width, root.width(), root.width(),
+                    );
+                }
+            });
+        });
+    }
+
