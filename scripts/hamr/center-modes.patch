+
+/// Saved X ratios describe the center, independent of the active mode's width.
+#[allow(clippy::cast_possible_truncation)]
+fn horizontal_anchor_left(ratio: f64, screen_width: i32, launcher_width: i32) -> i32 {
+    let left = (ratio * f64::from(screen_width) - f64::from(launcher_width) / 2.0).floor() as i32;
+    left.max(-(launcher_width - 60)).min(screen_width - launcher_width)
+}
+
+#[cfg(test)]
+mod horizontal_anchor_tests {
+    use super::horizontal_anchor_left;
+
+    #[test]
+    fn mode_width_changes_keep_the_same_center_on_both_primary_displays() {
+        for screen in [1920, 3440] {
+            for width in [640, 540, 900, 641] {
+                let left = horizontal_anchor_left(0.5, screen, width);
+                assert!((2 * left + width - screen).abs() <= 1);
+            }
+        }
+    }
+
+    #[test]
+    fn saved_drag_position_is_center_based_and_keeps_handle_accessible() {
+        assert_eq!(horizontal_anchor_left(0.25, 1920, 640), 160);
+        assert_eq!(horizontal_anchor_left(0.25, 1920, 540), 210);
+        assert_eq!(horizontal_anchor_left(1.0, 1920, 640), 1280);
+        assert_eq!(horizontal_anchor_left(0.0, 1920, 640), -320);
+    }
+}
