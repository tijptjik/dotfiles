#!/usr/bin/env fish
{{ if and (eq .chezmoi.os "linux") .isClient -}}
{{ include ".chezmoihelpers/desktop-user.fish" }}
{{ include ".chezmoihelpers/status.fish" }}
{{ include ".chezmoitemplates/fish_logging.fish" }}
setup_logging linux-install-tippecanoe
set installer_dir (mktemp -d); or exit 1
set installer "$installer_dir/installer.py"
printf '%s' {{ include ".chezmoitemplates/github_api.py" | b64enc | quote }} | base64 --decode > "$installer_dir/github_api.py"
and printf '%s' {{ include ".chezmoitemplates/install-tippecanoe.py" | b64enc | quote }} | base64 --decode > "$installer"
set write_result $status
if test $write_result -ne 0
    rm -rf "$installer_dir"
    exit $write_result
end
step_run_quiet "Tippecanoe" /usr/bin/python3 -B "$installer"
set install_result $status
rm -rf "$installer_dir"
exit $install_result
{{ end -}}
