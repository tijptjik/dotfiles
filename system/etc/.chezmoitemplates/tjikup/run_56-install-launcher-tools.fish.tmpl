#!/usr/bin/env fish
{{ if and (eq .chezmoi.os "linux") .isClient -}}
{{ include ".chezmoihelpers/desktop-user.fish" }}
{{ include ".chezmoihelpers/status.fish" }}
{{ include ".chezmoitemplates/fish_logging.fish" }}
setup_logging linux-install-launcher-tools
function install_launcher_tools
    if test (uname -m) != x86_64
        echo "Gitfetch release is pinned for x86_64" >&2
        return 1
    end
    set -l missing
    for package in python3-pip
        rpm -q $package >/dev/null 2>&1; or set -a missing $package
    end
    if test (count $missing) -gt 0
        sudo -n dnf install -y $missing; or return $status
    end
    set -l installer_dir (mktemp -d); or return 1
    set -l installer "$installer_dir/installer.py"
    printf '%s' {{ include ".chezmoitemplates/github_api.py" | b64enc | quote }} | base64 --decode > "$installer_dir/github_api.py"
    and printf '%s' {{ include ".chezmoitemplates/install-launcher-tools.py" | b64enc | quote }} | base64 --decode > "$installer"
    set -l write_result $status
    if test $write_result -ne 0
        rm -rf "$installer_dir"
        return $write_result
    end
    sudo -n python3 -B "$installer"
    set -l result $status
    rm -rf "$installer_dir"
    test $result -eq 0; or return $result
    # Do not publish compatibility links after a no-op or incomplete install.
    for name in gitfetch
        if not test -x /usr/local/bin/$name
            echo "Launcher installation did not produce /usr/local/bin/$name" >&2
            return 1
        end
    end
    set -l backup "$HOME/.local/state/chezetc/launcher-tools/"(date +%Y%m%dT%H%M%S%N)
    mkdir -p "$HOME/.local/bin" "$backup"; or return 1
    for name in gitfetch
        set -l path "$HOME/.local/bin/$name"
        if test -e "$path"; and not test -L "$path"
            cp -p "$path" "$backup/$name"; or return 1
        end
        ln -sfn /usr/local/bin/$name "$path"; or return 1
    end

end
step_run_quiet "Gitfetch" install_launcher_tools
or exit $status
{{ end -}}
