################################
###  TYPE.HK - NGINX CONFIG  ###
################################

# The public site is hosted on Cloudflare. Unknown hosts must not serve
# retired local site assets or fall through to another service.
server {
    listen 8443 ssl default_server;
    http2 on;
    include /etc/nginx/conf.d/ssl_type.hk.conf;

    server_name _ type.hk www.type.hk;
    return 301 https://type.hk$request_uri;
}
# Public dashboards; unauthenticated access explicitly approved.
server {
    include /etc/nginx/snippets/server_template.conf;
    server_name home.type.hk;

    # Runtime configuration assets must not be cached as immutable/static CSS.
    location ^~ /api/config/ {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/reverse_proxy.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/reverse_proxy.conf;
    }
}

server {
    include /etc/nginx/snippets/server_template.conf;
    server_name storage.type.hk;

    location / {
        proxy_pass http://127.0.0.1:8085;
        include /etc/nginx/snippets/reverse_proxy.conf;
    }
}

