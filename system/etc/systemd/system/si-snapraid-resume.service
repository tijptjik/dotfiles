[Unit]
Description=Resume only containers paused by interrupted SnapRAID maintenance
ConditionHost=si
OnFailure=si-snapraid-alert@%n.service
OnSuccess=si-snapraid-recovered@%n.service
Requires=docker.service
After=docker.service
Before=si-snapraid-sync.service si-snapraid-scrub.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /etc/si-snapraid-maintenance/maintenance.py resume
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
