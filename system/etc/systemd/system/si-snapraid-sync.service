[Unit]
Description=Guarded SnapRAID sync
ConditionHost=si
OnFailure=si-snapraid-alert@%n.service
OnSuccess=si-snapraid-recovered@%n.service
Requires=docker.service si-snapraid-resume.service
After=docker.service si-snapraid-resume.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /etc/si-snapraid-maintenance/maintenance.py sync
ExecStopPost=/usr/bin/python3 /etc/si-snapraid-maintenance/maintenance.py resume
TimeoutStartSec=infinity
TimeoutStopSec=10min
KillSignal=SIGINT
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
