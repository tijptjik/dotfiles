{%- if is_client %}
[Service]
# Fi reaches Tailscale coordination and relays through Mullvad. Excluding
# this daemon prevents coordination on the current network.
ExecStart=
ExecStart=/usr/sbin/tailscaled --state=/var/lib/tailscale/tailscaled.state --socket=/run/tailscale/tailscaled.sock --port=${PORT} $FLAGS
{%- endif %}
