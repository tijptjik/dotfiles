{
  "version": 1,
  "id": "system-li",
  "host": "li",
  "context": {
    "hostname": "li",
    "is_desktop": false,
    "is_laptop": true,
    "is_server": false,
    "is_client": true,
    "system_user": "root",
    "os": "linux",
    "distribution": "fedora",
    "release": 45
  },
  "entries": [
    {
      "kind": "file",
      "path": "/etc/dnf/dnf.conf",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "source": "files/dnf/dnf.conf"
    },
    {
      "kind": "file",
      "path": "/etc/dnf/repos.override.d/60-tjikup-docker.repo",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "template": true,
      "source": "files/dnf/repos.override.d/60-tjikup-docker.repo.j2"
    },
    {
      "kind": "file",
      "path": "/etc/fail2ban/jail.local",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "source": "files/fail2ban/jail.local"
    },
    {
      "kind": "file",
      "path": "/etc/fstab",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "template": true,
      "source": "files/fstab.j2"
    },
    {
      "kind": "file",
      "path": "/etc/gdm/custom.conf",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "template": true,
      "source": "files/gdm/custom.conf.j2"
    },
    {
      "kind": "file",
      "path": "/etc/pam.d/hyprlock",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "source": "files/pam.d/hyprlock"
    },
    {
      "kind": "absent",
      "path": "/etc/snapraid.conf"
    },
    {
      "kind": "file",
      "path": "/etc/ssh/ssh_config.d/10-connection-reuse.conf",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "source": "files/ssh/ssh_config.d/10-connection-reuse.conf"
    },
    {
      "kind": "file",
      "path": "/etc/ssh/ssh_config.d/30-libvirt-ssh-proxy.conf",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "source": "files/ssh/ssh_config.d/30-libvirt-ssh-proxy.conf"
    },
    {
      "kind": "file",
      "path": "/etc/ssh/ssh_config.d/50-redhat.conf",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "source": "files/ssh/ssh_config.d/50-redhat.conf"
    },
    {
      "kind": "symlink",
      "path": "/etc/ssh/ssh_config.d/20-systemd-ssh-proxy.conf",
      "target": "../../../usr/lib/systemd/ssh_config.d/20-systemd-ssh-proxy.conf",
      "uid": 0,
      "gid": 0
    },
    {
      "kind": "file",
      "path": "/etc/ssh/ssh_config",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "template": true,
      "source": "files/ssh/ssh_config.j2"
    },
    {
      "kind": "file",
      "path": "/etc/sysctl.conf",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "template": true,
      "source": "files/sysctl.conf.j2"
    },
    {
      "kind": "file",
      "path": "/etc/systemd/system/tailscaled.service.d/override.conf",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "template": true,
      "source": "files/systemd/system/tailscaled.service.d/override.conf.j2"
    },
    {
      "kind": "symlink",
      "path": "/etc/usr/local/bin/bun",
      "target": "/home/{{ system_user }}/.bun/bin/bun",
      "uid": 0,
      "gid": 0
    },
    {
      "kind": "file",
      "path": "/etc/xdg/monitors.xml",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "template": true,
      "source": "files/xdg/monitors.xml.j2",
      "when": "is_desktop"
    },
    {
      "kind": "file",
      "path": "/etc/yum.repos.d/fedora-cisco-openh264.repo",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "when": "not (distribution == \"fedora\" and release >= 45)",
      "source": "files/yum.repos.d/fedora-cisco-openh264.repo"
    },
    {
      "kind": "file",
      "path": "/etc/yum.repos.d/fedora-updates.repo",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "when": "not (distribution == \"fedora\" and release >= 45)",
      "source": "files/yum.repos.d/fedora-updates.repo"
    },
    {
      "kind": "file",
      "path": "/etc/yum.repos.d/fedora.repo",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "when": "not (distribution == \"fedora\" and release >= 45)",
      "source": "files/yum.repos.d/fedora.repo"
    },
    {
      "kind": "file",
      "path": "/etc/yum.repos.d/firefoxpwa.repo",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "source": "files/yum.repos.d/firefoxpwa.repo"
    },
    {
      "kind": "file",
      "path": "/etc/yum.repos.d/google-chrome.repo",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "when": "not (distribution == \"fedora\" and release >= 45)",
      "source": "files/yum.repos.d/google-chrome.repo"
    },
    {
      "kind": "absent",
      "path": "/etc/yum.repos.d/plex.repo"
    },
    {
      "kind": "absent",
      "path": "/etc/dnf/repos.override.d/60-chezetc-docker.repo"
    },
    {
      "kind": "file",
      "path": "/etc/docker/daemon.json",
      "source": "files/docker/daemon.json",
      "mode": "0644",
      "uid": 0,
      "gid": 0
    },
    {
      "kind": "file",
      "path": "/etc/sysctl.d/90-tjikup-docker.conf",
      "source": "files/sysctl.d/90-tjikup-docker.conf",
      "mode": "0644",
      "uid": 0,
      "gid": 0
    },
    {
      "kind": "file",
      "path": "/etc/systemd/system/tailnet-dns.service",
      "source": "files/systemd/system/tailnet-dns.service",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "group": "tailnet-dns"
    },
    {
      "kind": "file",
      "path": "/etc/tailnet-mullvad.nft",
      "source": "files/tailnet-mullvad.nft",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "group": "tailnet-mullvad"
    },
    {
      "kind": "file",
      "path": "/etc/systemd/system/tailnet-mullvad.service",
      "source": "files/systemd/system/tailnet-mullvad.service",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "group": "tailnet-mullvad"
    },
    {
      "kind": "file",
      "path": "/etc/systemd/system/tailnet-dns.timer",
      "source": "files/systemd/system/tailnet-dns.timer",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "group": "tailnet-dns"
    }
  ]
}
