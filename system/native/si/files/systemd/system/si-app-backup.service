[Unit]
Description=Consistent encrypted application-state backup
ConditionHost=si
RequiresMountsFor=/mnt/storage /mnt/data/disk42
After=docker.service
OnFailure=si-app-backup-failure.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/synctjik app-backup backup
TimeoutStartSec=2h
TimeoutStopSec=5min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
