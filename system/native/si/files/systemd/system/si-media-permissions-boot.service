[Unit]
Description=Establish shared video permissions before container autostart
ConditionHost=si
RequiresMountsFor=/mnt/storage /mnt/data/disk12 /mnt/data/disk22 /mnt/data/disk32 /mnt/data/disk42 /mnt/data/disk5
After=local-fs.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /etc/si-media-permissions/permissions.py --apply
SuccessExitStatus=75
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
