[Unit]
Description=Send SnapRAID failure notification
ConditionHost=si
ConditionPathExists=/etc/si-notifications/telegram.json
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
StateDirectory=si-snapraid-notifications
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=5min
TimeoutStartSec=2min
ExecStart=/usr/local/bin/synctjik snapraid-notify failure %i
