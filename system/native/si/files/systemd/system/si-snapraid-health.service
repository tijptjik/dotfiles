[Unit]
Description=Detect missed or stalled SnapRAID maintenance
ConditionHost=si
ConditionPathExists=/etc/notjik/system-client.json
After=network-online.target
StartLimitIntervalSec=0

[Service]
ReadWritePaths=/var/lib/notjik-system-client
Type=oneshot
StateDirectory=si-snapraid-notifications
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=5min
TimeoutStartSec=2min
ExecStart=/usr/local/bin/synctjik snapraid-notify health
