[Unit]
Description=Remove completed managed torrents after their seeding requirement
ConditionHost=si
After=docker.service
Requires=docker.service
RequiresMountsFor=/mnt/storage/meta/downloads

[Service]
Type=oneshot
ExecStart=/usr/local/lib/tjikup/tjikup system transmission-cleanup --apply
StateDirectory=si-transmission-cleanup
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/si-transmission-cleanup
