[Unit]
Description=Private tailnet service-name DNS
After=tailscaled.service sys-subsystem-net-devices-tailscale0.device
Requires=tailscaled.service

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/dnsmasq --keep-in-foreground --conf-file=/etc/tasktjik-shortcuts/dnsmasq.conf --pid-file=
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
