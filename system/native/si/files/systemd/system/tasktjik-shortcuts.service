[Unit]
Description=Private Tasktjik short-name redirects
After=tailscaled.service sys-subsystem-net-devices-tailscale0.device
Requires=tailscaled.service

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=tasktjik-shortcuts
ExecStartPre=/usr/sbin/nginx -t -c /etc/tasktjik-shortcuts/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/tasktjik-shortcuts/nginx.conf -g "daemon off;"
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
