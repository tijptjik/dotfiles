    {
      "id": "system:copr",
      "label": "Fedora (COPR repositories)",
      "needs": [
        "system:render"
      ],
      "resources": [
        "dnf"
      ],
      "apply": [
        "sudo",
        "-n",
        "-H",
        "--",
        "env",
        "TJIKUP_REPORT_FILE={run_dir}/system:copr.report",
        "TJIKUP_STATUS_LINES=1",
        "TJIKUP_STATUS_SECTIONS=1",
        "TJIKUP_NO_SPIN=1",
        "TJIKUP_NO_SECTIONS=1",
        "fish",
        "--no-config",
        "{run_dir}/system-run_10-install-copr-repos.fish"
      ],
      "env": {
        "TJIKUP_STATUS_LINES": "1",
        "TJIKUP_NO_SPIN": "1",
        "TJIKUP_NO_SECTIONS": "1"
      },
      "timeout": 7200,
      "display": {
        "section": "Recipes",
        "reports": true,
        "icon": "Fedora"
      },
      "optional": true
    },
