{
  "version": 2,
  "title": "tjikOS",
  "jobs": 4,
  "locks": [
    "{config_dir}/.git/tjikup-workflow.lock"
  ],
  "flags": {
    "upgrade": "FLEET_UPGRADE",
    "skip-repo-sync": "FLEET_SKIP_REPO_SYNC",
    "skip-conflicts": "FLEET_SKIP_CONFLICTS"
  },
  "env": {
    "DOTJIK_REPO": "{config_dir}",
    "SYSTJIK_REPO": "{config_dir}/system",
    "TJIKOS_REPO": "~/code/tjikos",
    "TJIKUP_SKIP_PREFLIGHT": "1",
    "TJIKUP_QUIET_CONFIG": "1",
    "GIT_TERMINAL_PROMPT": "0",
    "FLEET_UPGRADE": "0"
  },
  "includes": [
    "tjikup/recipes.json",
    "$SYSTJIK_REPO/tjikup/recipes.json"
  ],
  "prerequisites": [],
  "recipes": [
    {
      "id": "require:fish",
      "check": [
        "fish",
        "--version"
      ],
      "display": {
        "icon": "Fish",
        "section": "Prerequisites",
        "verb": "REQUIRE"
      },
      "label": "Fish",
      "needs": []
    },
    {
      "id": "require:sudo",
      "check": [
        "sudo",
        "-n",
        "true"
      ],
      "display": {
        "icon": "Terminal",
        "section": "Prerequisites",
        "verb": "REQUIRE"
      },
      "label": "sudo",
      "needs": []
    },
    {
      "id": "capture",
      "label": "Capture live settings",
      "apply": [
        "tjikup",
        "workflow",
        "capture"
      ],
      "display": {
        "section": "Capture changes",
        "reports": true,
        "icon": "Tjikup"
      },
      "optional": false,
      "needs": [],
      "after": []
    },
    {
      "id": "capture:commit",
      "label": "Commit captured changes",
      "needs": [
        "capture"
      ],
      "autocommit": {
        "repository": "$DOTJIK_REPO",
        "files": [
          "native/home/data/gtk-bookmarks.json",
          "native/home/data/zapzap.json",
          "native/home/files/.codex/config.toml",
          "native/home/files/.config/fcitx5/profile",
          "native/home/files/.config/herdr/session.json.j2",
          "native/home/files/.config/solaar/config.yaml",
          "native/home/files/.config/zed/settings.json.j2",
          "native/home/files/.config/herdr/session-li.json.j2"
        ],
        "message": "sync: update templates"
      },
      "display": {
        "section": "Capture changes",
        "quiet": true,
        "icon": "Tjikup"
      },
      "optional": false,
      "after": []
    },
    {
      "id": "repo:home:pull",
      "label": "home pull",
      "needs": [
        "capture:commit"
      ],
      "git": {
        "repository": "$DOTJIK_REPO",
        "operation": "pull-rebase"
      },
      "timeout": 600,
      "when": {
        "environment": "FLEET_SKIP_REPO_SYNC",
        "equals": "0"
      },
      "display": {
        "repository": "dotjik",
        "operation": "pull"
      },
      "optional": false,
      "after": []
    },
    {
      "id": "repo:home:push",
      "label": "home push",
      "needs": [
        "repo:home:pull"
      ],
      "git": {
        "repository": "$DOTJIK_REPO",
        "operation": "push"
      },
      "timeout": 600,
      "when": {
        "environment": "FLEET_SKIP_REPO_SYNC",
        "equals": "0"
      },
      "display": {
        "repository": "dotjik",
        "operation": "push"
      },
      "optional": false,
      "after": []
    },
    {
      "id": "repo:tjikos:pull",
      "label": "tjikos pull",
      "needs": [
        "capture:commit"
      ],
      "git": {
        "repository": "$TJIKOS_REPO",
        "operation": "pull-ff"
      },
      "timeout": 600,
      "when": {
        "environment": "FLEET_SKIP_REPO_SYNC",
        "equals": "0"
      },
      "display": {
        "repository": "tjikOS",
        "operation": "pull"
      },
      "optional": false,
      "after": []
    },
    {
      "id": "repo:tjikos:push",
      "label": "tjikos push",
      "needs": [
        "repo:tjikos:pull"
      ],
      "git": {
        "repository": "$TJIKOS_REPO",
        "operation": "push"
      },
      "timeout": 600,
      "when": {
        "environment": "FLEET_SKIP_REPO_SYNC",
        "equals": "0"
      },
      "display": {
        "repository": "tjikOS",
        "operation": "push"
      },
      "optional": false,
      "after": []
    }
  ],
