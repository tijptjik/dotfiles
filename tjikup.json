{
  "version": 1,
  "flags": {
    "skip-conflicts": {
      "env": "FLEET_SKIP_CONFLICTS",
      "help": "skip conflicting files during home and system apply"
    },
    "upgrade": {
      "env": "FLEET_UPGRADE",
      "help": "check for home package upgrades as well as applying configuration"
    }
  },
  "steps": [
    {
      "id": "fleet",
      "command": [
        "python3",
        "{config_dir}/scripts/fleet-update.py",
        "workflow"
      ],
      "preview": [
        "python3",
        "{config_dir}/scripts/fleet-update.py",
        "workflow",
        "--dry-run"
      ],
      "label": "Fleet DAG",
      "output": "stream",
      "timeout": 7200,
      "stop_codes": [
        78
      ],
      "summary": false
    }
  ],
  "banner": {
    "title": "Tijpfiles",
    "url": "https://github.com/tijptjik/dotfiles"
  }
}
