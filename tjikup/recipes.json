{
  "version": 2,
  "recipes": [
    {
      "id": "home:render-prelude",
      "label": "Prepare home prerequisites",
      "needs": [
        "repo:home:push",
        "repo:tjikos:push"
      ],
      "render": {
        "manager": "home",
        "templates": [
          {
            "name": "home-run_before_02-install-bws.fish",
            "source": "{config_dir}/../home/.chezmoitemplates/tjikup/run_before_02-install-bws.fish.tmpl",
            "syntax": [
              "fish",
              "--no-config",
              "--no-execute",
              "{script}"
            ]
          },
          {
            "name": "home-run_before_71-consolidate-user-fonts.py",
            "source": "{config_dir}/../home/.chezmoitemplates/tjikup/run_before_71-consolidate-user-fonts.py.tmpl",
            "syntax": [
              "python3",
              "-c",
              "import ast,sys; ast.parse(open(sys.argv[1]).read())",
              "{script}"
            ]
          }
        ]
      },
      "display": {
        "section": "Recipes",
        "quiet": true,
        "icon": "Chezmoi"
      },
      "optional": false
    },
    {
      "id": "home:bitwarden",
      "label": "Bitwarden CLIs",
      "needs": [
        "home:render-prelude"
      ],
      "resources": [
        "dnf"
      ],
      "apply": [
        "fish",
        "--no-config",
        "{run_dir}/home-run_before_02-install-bws.fish"
      ],
      "env": {
        "TJIKUP_STATUS_LINES": "1",
        "TJIKUP_NO_SPIN": "1",
        "TJIKUP_NO_SECTIONS": "1"
      },
      "timeout": 7200,
      "display": {
        "section": "Recipes",
        "reports": true,
        "icon": "Bitwarden"
      },
      "optional": false
    },
    {
      "id": "home:font-migration",
      "label": "Font folder migration",
      "needs": [
        "home:render-prelude"
      ],
      "resources": [
        "fonts"
      ],
      "apply": [
        "python3",
        "{run_dir}/home-run_before_71-consolidate-user-fonts.py"
      ],
      "env": {
        "TJIKUP_STATUS_LINES": "1",
        "TJIKUP_NO_SPIN": "1",
        "TJIKUP_NO_SECTIONS": "1"
      },
      "timeout": 7200,
      "display": {
        "section": "Recipes",
        "reports": true,
        "icon": "Assets (user fonts)"
      },
      "optional": true,
      "hosts": [
        "fi",
        "li"
      ],
      "roles": [
        "desktop",
        "laptop"
      ]
    },
    {
      "id": "home:files",
      "label": "Home configuration",
      "needs": [
        "home:bitwarden",
        "home:archive-restore"
      ],
      "timeout": 1800,
      "display": {
        "section": "Recipes",
        "quiet": true,
        "icon": "Chezmoi"
      },
      "check": [
        "python3",
        "{config_dir}/../scripts/native-files.py",
        "home-files",
        "check"
      ],
      "apply": [
        "python3",
        "{config_dir}/../scripts/native-files.py",
        "home-files",
        "apply"
      ],
      "resources": [
        "home-files"
      ],
      "optional": false,
      "after": [
        "home:font-migration"
      ]
    },
